#!/usr/bin/env bash
# fcd: the only way to build, test, check, deploy and release. Deelproduct Pipeline of the product FCD.
# One Pipeline for all showcases: what differs per showcase is in its configuration (the declarative
# files fcd-<showcase>/fcd/*.fcd.yaml), never in this script.
#
#   fcd check [--showcase dir]           what is missing before anything goes wrong
#   fcd ci [repo] [options]              the CI steps and quality gates of the showcase, for one repository
#       --env werkplek|lokaal            werkplek (default): before a push; lokaal: after a merge on main (agent)
#       --showcase dir                   the showcase repository (default: found next to the repository)
#   fcd bump [repo] <container|subproduct> <major|minor|patch>
#   fcd hooks [repo]                     install the pre-push hook (same steps and gates before a push)
#   fcd up [--showcase dir]              start the showcase: Dashboard and Pipeline agent of the pinned versions
#   fcd down | status | logs [--showcase dir]
#   fcd agent --showcase dir [--once]    the Pipeline: fetch main (GitOps), run ci, deploy, release
#   fcd report [--showcase dir]          save the status report and the log in the showcase repository
#   fcd experiment [start <name>] [--showcase dir]
#   fcd version
#
# Works with bash 3.2 (macOS) and any docker runtime with `docker` and `docker compose`.
# Every step and gate sends a log line (CDEvents, contract in fcd-dashboard/contracts) to the Dashboard
# of the showcase.
set -euo pipefail

FCD_SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
FCD_PIPELINE_DIR="${FCD_PIPELINE_DIR:-$(dirname "$FCD_SELF")}"
FCD_HOME="${FCD_HOME:-$HOME/.fcd}"
FCD_ORG_URL="${FCD_ORG_URL:-https://github.com/fcd-labs}"
FCD_AGENT_INTERVAL="${FCD_AGENT_INTERVAL:-30}"
FCD_COMMAND_INTERVAL="${FCD_COMMAND_INTERVAL:-2}"       # how often the agent asks the Dashboard for a command (button)
FCD_APPROVAL_TIMEOUT="${FCD_APPROVAL_TIMEOUT:-900}"     # how long the human gate waits for the button before it closes
FCD_ROOT="$(dirname "$FCD_PIPELINE_DIR")"   # the folder with all repositories next to each other

# shellcheck source=tools.env
. "$FCD_PIPELINE_DIR/tools.env"
FCD_VERSION="$(sed -n 's/^SUBPRODUCT_VERSION=//p' "$FCD_PIPELINE_DIR/versions.env")"

# ---------------------------------------------------------------- output

if [ -t 1 ]; then C_OK=$'\033[32m'; C_ERR=$'\033[31m'; C_DIM=$'\033[2m'; C_B=$'\033[1m'; C_0=$'\033[0m'
else C_OK=""; C_ERR=""; C_DIM=""; C_B=""; C_0=""; fi
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s✓%s %s\n' "$C_OK" "$C_0" "$*"; }
bad()  { printf '%s✗%s %s\n' "$C_ERR" "$C_0" "$*"; }
info() { printf '%s%s%s\n' "$C_DIM" "$*" "$C_0"; }
die()  { bad "$*" >&2; exit 1; }

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }
now_s()   { date -u +%s; }

json_str() { # JSON string literal
  local s=${1-}
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\r'/}; s=${s//$'\t'/ }
  printf '"%s"' "$s"
}

uuid() {
  if [ -r /proc/sys/kernel/random/uuid ]; then cat /proc/sys/kernel/random/uuid
  else uuidgen | tr '[:upper:]' '[:lower:]'; fi
}

# ---------------------------------------------------------------- configuration of the showcase

# The declarative files of the showcase, flattened to lines "Kind/name/path=value" (one yq call).
CFG=""
cfg_load() { # showcase repository dir -> $CFG (a file)
  local dir=$1 out=$2
  ls "$dir"/fcd/*.fcd.yaml >/dev/null 2>&1 || die "$dir: geen declaratieve bestanden (fcd/*.fcd.yaml)"
  local cfg_files=() f
  for f in "$dir"/fcd/*.fcd.yaml; do cfg_files+=("/cfg/$(basename "$f")"); done
  docker run --rm -v "$dir/fcd":/cfg:ro "$TOOL_YQ" ea \
    '. as $d | $d | .. | select(tag != "!!map" and tag != "!!seq") | ($d.kind + "/" + $d.metadata.name + "/" + (path | join("/"))) + "=" + (. | tostring)' \
    "${cfg_files[@]}" >"$out" || die "configuratie van $dir niet te lezen"
  CFG=$out
}
cfg() { # kind name path [default]
  local v; v=$(awk -v k="$1/$2/$3=" 'index($0, k) == 1 { print substr($0, length(k) + 1); exit }' "$CFG")
  printf '%s' "${v:-${4:-}}"
}
cfg_list() { # kind name path -> the items of a list, one per line, in order
  awk -v k="$1/$2/$3/" 'index($0, k) == 1 { r = substr($0, length(k) + 1); i = index(r, "="); n = substr(r, 1, i - 1)
    if (n ~ /^[0-9]+$/) print n "\t" substr(r, i + 1) }' "$CFG" | sort -n | cut -f2-
}
cfg_keys() { # kind name path -> the keys of a map, one per line
  awk -v k="$1/$2/$3/" 'index($0, k) == 1 { r = substr($0, length(k) + 1); split(r, p, "[/=]"); if (!seen[p[1]]++) print p[1] }' "$CFG"
}
cfg_names() { # kind -> the names of all objects of that kind
  awk -F/ -v k="$1" '$1 == k && !seen[$2]++ { print $2 }' "$CFG"
}
cfg_first() { cfg_names "$1" | head -1; }

# The showcase: its repository (with fcd/*.fcd.yaml) and where its data lives on this machine.
SC_REPO=""; SC_NAME=""; SC_HOME=""; SC_PREFIX=""
showcase_for_repo() { # repo dir -> showcase repository dir: the fcd-* next to it whose configuration names this repository
  local name=$1 d
  for d in "$FCD_ROOT"/fcd-*/fcd "$(dirname "$2")"/fcd-*/fcd; do
    [ -d "$d" ] || continue
    # Only a SubProduct makes a repository part of the showcase (a Contract may name another repository).
    grep -qE "repository:[[:space:]]*${name}[[:space:]]*$" "$d"/*.fcd.yaml 2>/dev/null || continue
    local sc_files=() f
    for f in "$d"/*.fcd.yaml; do sc_files+=("/cfg/$(basename "$f")"); done
    if docker run --rm -v "$d":/cfg:ro "$TOOL_YQ" ea 'select(.kind == "SubProduct") | .spec.repository' "${sc_files[@]}" 2>/dev/null | grep -qx "$name"; then
      dirname "$d"; return
    fi
  done
}
showcase_load() { # showcase repository dir, a place for the flattened config
  SC_REPO=$(cd "$1" && pwd)
  cfg_load "$SC_REPO" "$2"
  local factory; factory=$(cfg_first Factory)
  SC_NAME=$(cfg Factory "$factory" spec/showcase)
  [ -n "$SC_NAME" ] || die "$SC_REPO: Factory zonder spec.showcase"
  # D1 (interim): FCD's own sub-products use the configuration of a showcase until it is in fcd; their data is
  # kept apart as showcase "fcd". Issue in fcd: the configuration of FCD itself.
  [ -n "${FCD_SHOWCASE_OVERRIDE:-}" ] && SC_NAME=$FCD_SHOWCASE_OVERRIDE
  SC_HOME="$FCD_HOME/$SC_NAME"; mkdir -p "$SC_HOME"
  local env; env=$(cfg_first Environment)
  SC_PREFIX=$(cfg Environment "$env" spec/composeProjectPrefix "$SC_NAME")
  [ -n "${FCD_SHOWCASE_OVERRIDE:-}" ] && SC_PREFIX=$SC_NAME
  # Ports of the environment, for the compose files: PORT_DASHBOARD, PORT_BESTELLEN, ...
  local k v
  for k in $(cfg_keys Environment "$env" spec/ports); do
    v=$(cfg Environment "$env" "spec/ports/$k")
    export "PORT_$(printf '%s' "$k" | tr '[:lower:]-' '[:upper:]_')=$v"
  done
  if [ -n "${FCD_SHOWCASE_OVERRIDE:-}" ]; then export PORT_DASHBOARD="${FCD_PORT_DASHBOARD:-8370}" PORT_REGISTRY="${FCD_PORT_REGISTRY:-8371}"; fi
  FCD_REGISTRY_URL="${FCD_REGISTRY_URL:-http://127.0.0.1:${PORT_REGISTRY:-0}/apis/registry/v3}"
  FCD_DASHBOARD_URL="${FCD_DASHBOARD_URL:-http://127.0.0.1:${PORT_DASHBOARD:-0}/api/v1/events}"
  export DASHBOARD_EVENTS_URL="http://host.docker.internal:${PORT_DASHBOARD:-0}/api/v1/events"
  export FCD_SHOWCASE="$SC_NAME"
  # Where the repositories come from (configuration: Pipeline.spec.source). local-git: bare repositories on this
  # machine ($FCD_HOME/git), nothing goes to a remote (demo). Otherwise the origin of the checkouts next to it.
  if [ "$(cfg Pipeline "$(cfg_first Pipeline)" spec/source origin)" = local-git ] && [ -z "${FCD_REPO_BASE:-}" ]; then
    export FCD_REPO_BASE="$FCD_HOME/git"
  fi
}
showcase_dir_arg() { # [--showcase dir] -> a showcase repository: the given one, the current dir, or fcd-demo next to the Pipeline
  if [ -n "${1:-}" ]; then printf '%s' "$1"
  elif ls ./fcd/*.fcd.yaml >/dev/null 2>&1; then pwd
  else printf '%s' "$FCD_ROOT/fcd-demo"; fi
}
experiment_of() { cat "$SC_HOME/experiment" 2>/dev/null || cfg Factory "$(cfg_first Factory)" spec/experiment mvp0; }

# ---------------------------------------------------------------- check

cmd_check() {
  local sc="" missing=0
  [ "${1:-}" = --showcase ] && sc=$2
  say "${C_B}fcd check${C_0} (Pipeline $FCD_VERSION)"
  if command -v git >/dev/null; then ok "git $(git --version | awk '{print $3}')"; else bad "git ontbreekt: installeer git"; missing=1; fi
  ok "bash $BASH_VERSION"
  if command -v curl >/dev/null; then ok "curl"; else bad "curl ontbreekt: installeer curl"; missing=1; fi
  if command -v docker >/dev/null; then
    if docker info >/dev/null 2>&1; then ok "docker werkt"; else bad "docker is er, maar draait niet: start je container-runtime"; missing=1; fi
    if docker compose version >/dev/null 2>&1; then ok "docker compose $(docker compose version --short 2>/dev/null)"; else bad "docker compose ontbreekt (compose v2)"; missing=1; fi
  else bad "docker ontbreekt: installeer een container-runtime met docker en docker compose"; missing=1; fi
  [ "$missing" -eq 0 ] || { bad "er mist iets (zie hierboven)"; return 1; }
  local dir; dir=$(showcase_dir_arg "$sc")
  [ -d "$dir/.git" ] || { bad "showcase-repository $dir ontbreekt"; return 1; }
  showcase_load "$dir" "$(mktemp)"
  ok "showcase $SC_NAME ($SC_REPO)"
  local r
  for r in fcd fcd-pipeline fcd-dashboard $(cfg_names SubProduct | while read -r s; do cfg SubProduct "$s" spec/repository; done | sort -u); do
    if [ -d "$FCD_ROOT/$r/.git" ]; then ok "repository $r"
    else bad "repository $r ontbreekt: git clone $FCD_ORG_URL/$r.git \"$FCD_ROOT/$r\""; missing=1; fi
  done
  local k p env; env=$(cfg_first Environment)
  for k in $(cfg_keys Environment "$env" spec/ports); do
    p=$(cfg Environment "$env" "spec/ports/$k")
    if (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null; then
      if docker ps --format '{{.Ports}}' 2>/dev/null | grep -q "127.0.0.1:$p->"; then ok "poort $p ($k, in gebruik door een container)"
      else bad "poort $p ($k) is bezet door een ander programma"; missing=1; fi
    else ok "poort $p ($k) vrij"; fi
  done
  if command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then ok "gh (optioneel, voor de GitHub Release)"
  else info "- gh ontbreekt of is niet ingelogd (optioneel): releasen wordt overgeslagen"; fi
  if [ "$missing" -eq 0 ]; then ok "alles aanwezig"; else bad "er mist iets (zie hierboven)"; return 1; fi
}

# ---------------------------------------------------------------- versions

ver_get() { sed -n "s/^$2=//p" "$1/versions.env" | head -1; }
ver_at_ref() { git -C "$1" show "$2:versions.env" 2>/dev/null | sed -n "s/^$3=//p" | head -1; }
ver_gt() { # $1 > $2 (semver x.y.z)
  [ "$1" = "$2" ] && return 1
  local a1 a2 a3 b1 b2 b3
  IFS=. read -r a1 a2 a3 <<<"$1"; IFS=. read -r b1 b2 b3 <<<"$2"
  [ "${a1:-0}" -ne "${b1:-0}" ] && { [ "${a1:-0}" -gt "${b1:-0}" ]; return; }
  [ "${a2:-0}" -ne "${b2:-0}" ] && { [ "${a2:-0}" -gt "${b2:-0}" ]; return; }
  [ "${a3:-0}" -gt "${b3:-0}" ]
}
ver_ge() { [ -n "$1" ] && ! ver_gt "$2" "$1"; }   # $1 >= $2; an empty version is never >=
last_tag() { git -C "$1" tag --list 'v[0-9]*' --sort=-v:refname | head -1; }

changelog_heading() { # the heading line of a version in CHANGELOG.md
  grep -E "^## \[$2\]" "$1/CHANGELOG.md" 2>/dev/null | head -1 || true
}
changelog_until() { # repo version -> CHANGELOG.md from the heading of that version to the end (at most 16000 characters)
  [ -f "$1/CHANGELOG.md" ] || return 0
  awk -v v="$2" 'index($0, "## [" v "]") == 1 { on = 1 } on' "$1/CHANGELOG.md" | head -c 16000
}

changelog_section() { # text of a version section (without the heading)
  awk -v v="$2" '
    $0 ~ "^## \\[" v "\\]" {on=1; next}
    on && /^## \[/ {exit}
    on {print}' "$1/CHANGELOG.md"
}

# ---------------------------------------------------------------- log lines (CDEvents)

emit() { # type subject_id subject_content_json [duration_seconds]
  local type=$1 sid=$2 content=$3 dur=${4:-0}
  local ev
  ev=$(printf '{"context":{"version":"0.4.1","id":"%s","source":"fcd-pipeline/%s","type":"%s","timestamp":"%s"},"subject":{"id":%s,"source":"%s","content":%s},"customData":%s}' \
    "$(uuid)" "$FCD_VERSION" "$type" "$(now_iso)" "$(json_str "$sid")" "$R_NAME" "$content" "$(custom_data "$dur")")
  printf '%s\n' "$ev" >>"$R_DIR/events.jsonl"
  send_event "$ev"
}

send_event() { # to the Dashboard of the showcase; without a Dashboard into the outbox of the showcase
  if curl -fsS -m 3 -H 'Content-Type: application/json' -d "$1" "$FCD_DASHBOARD_URL" >/dev/null 2>&1; then
    flush_outbox
  else
    printf '%s\n' "$1" >>"$SC_HOME/outbox.jsonl"
  fi
}

flush_outbox() {
  local f="$SC_HOME/outbox.jsonl" line
  [ -s "$f" ] || return 0
  mv "$f" "$f.sending"
  while IFS= read -r line; do
    curl -fsS -m 3 -H 'Content-Type: application/json' -d "$line" "$FCD_DASHBOARD_URL" >/dev/null 2>&1 \
      || printf '%s\n' "$line" >>"$f"
  done <"$f.sending"
  rm -f "$f.sending"
}

custom_data() {
  local containers="" c v first=1
  for c in $R_CONTAINERS; do
    v=$(ver_get "$R_REPO" "$(container_var "$c")")
    [ $first -eq 1 ] || containers="$containers,"
    containers="$containers$(json_str "$c"):$(json_str "$v")"; first=0
  done
  printf '{"durationSeconds":%s,"run":%s,"commit":{"sha":%s,"time":%s},"trigger":{"kind":%s,"name":%s},"product":%s,"subProduct":{"name":%s,"version":%s,"containers":{%s}},"showcase":%s,"experiment":%s,"environment":%s,"releaseType":%s}' \
    "$1" "$(json_str "$R_ID")" "$(json_str "$R_SHA")" "$(json_str "$R_COMMIT_TIME")" \
    "$(json_str "$R_TRIGGER_KIND")" "$(json_str "$R_TRIGGER_NAME")" "$(json_str "$R_PRODUCT")" \
    "$(json_str "$R_SUBPRODUCT")" "$(json_str "$R_VERSION")" "$containers" \
    "$(json_str "$SC_NAME")" "$(json_str "$R_EXPERIMENT")" "$(json_str "$R_ENV")" "$(json_str "$R_RELEASE_TYPE")"
}

# Log lines of contract 0.4.0 (begin and end of every step and gate, for the live view of the Dashboard) go only
# to a Dashboard that knows them: the pinned Dashboard version of the showcase is 0.4.0 or higher (R_LIVE=1).
LIVE_SINCE_DASHBOARD=0.4.0
R_LIVE=0
# Contract 0.5.0 (rows per container, changelog at a deployment, the demo reset): only for a Dashboard of 0.5.0 or higher.
V05_SINCE_DASHBOARD=0.5.0
R_V05=0
R_CONTAINER=""
AGENT_RAN=0; AGENT_RESULT=""; AGENT_FAILED=0

# Commands of the Dashboard (contract dashboard-api): the buttons of the product owner.
dashboard_base() { printf '%s' "${FCD_DASHBOARD_URL%/api/v1/events}"; }
json_field() { # json key -> the value of a string, number or boolean field (flat objects of the Dashboard only)
  printf '%s' "$1" | sed -En "s/.*\"$2\":(\"([^\"]*)\"|([A-Za-z0-9.]+)).*/\2\3/p" | head -1
}
command_claim() { # kinds(comma separated) [run] -> the oldest pending command, claimed: "id<TAB>kind<TAB>requestedBy<TAB>save"
  local q="kind=$1" body
  [ -n "${2:-}" ] && q="$q&run=$2"
  body=$(curl -fsS -m 3 -X POST "$(dashboard_base)/api/v1/commands/claim?$q" 2>/dev/null) || return 0
  [ -n "$body" ] || return 0
  printf '%s\t%s\t%s\t%s\n' "$(json_field "$body" id)" "$(json_field "$body" kind)" "$(json_field "$body" requestedBy)" "$(json_field "$body" save)"
}
command_done() { # id outcome(done|failed|rejected) message
  curl -fsS -m 3 -H 'Content-Type: application/json' \
    -d "$(printf '{"outcome":%s,"message":%s}' "$(json_str "$2")" "$(json_str "$3")")" \
    "$(dashboard_base)/api/v1/commands/$1/done" >/dev/null 2>&1 || true
}

gate_started() { # gate key(afterSteps|beforeSteps) steps [waitingFor_json]
  [ "$R_LIVE" = 1 ] || return 0
  emit "dev.cdeventsx.fcd-qualitygate.started.0.1.0" "$1-gate" "$(printf '{"gate":%s,%s:%s%s}' "$(json_str "$1")" "$(json_str "$2")" "$(json_str "$3")" "${4:+,\"waitingFor\":$4}")"
}

container_json() { # ,"container":"<name>" for a step per container (only for a Dashboard that knows it)
  [ -n "$R_CONTAINER" ] && [ "$R_V05" = 1 ] && printf ',"container":%s' "$(json_str "$R_CONTAINER")"
  return 0
}

test_started() { # kind [expected]
  [ "$R_LIVE" = 1 ] || return 0
  emit "dev.cdevents.testsuiterun.started.0.2.0" "$1" "$(printf '{"testSuite":{"id":%s,"name":%s},"testType":%s%s%s}' "$(json_str "$R_ID-$1${R_CONTAINER:+-$R_CONTAINER}")" "$(json_str "$1")" "$(json_str "$1")" "${2:+,\"expected\":$2}" "$(container_json)")"
}

test_progressed() { # kind passed failed skipped: the count so far
  [ "$R_LIVE" = 1 ] || return 0
  emit "dev.cdeventsx.fcd-testsuiterun.progressed.0.1.0" "$1" "$(printf '{"testSuite":{"id":%s,"name":%s},"testType":%s,"tests":%s,"passed":%s,"failed":%s,"skipped":%s%s}' "$(json_str "$R_ID-$1${R_CONTAINER:+-$R_CONTAINER}")" "$(json_str "$1")" "$(json_str "$1")" "$(( $2 + $3 + $4 ))" "$2" "$3" "$4" "$(container_json)")"
}

watch_progress() { # kind output pid counter: a progressed log line at most once per second, only when the count changed
  local kind=$1 out=$2 pid=$3 counter=$4 last="0 0 0" now p f s
  while kill -0 "$pid" 2>/dev/null; do
    sleep 1
    now=$("$counter" "$out")
    [ "$now" = "$last" ] && continue
    last=$now; read -r p f s <<<"$now"
    test_progressed "$kind" "$p" "$f" "$s"
  done
}

playwright_counts() { # output of the list reporter -> "passed failed skipped" so far
  awk '/^ *(✓|ok) +[0-9]+ / { p++ } /^ *(✘|x) +[0-9]+ / { f++ } /^ *- +[0-9]+ / { s++ } END { print p + 0, f + 0, s + 0 }' "$1" 2>/dev/null
}

mask_secrets() { # text -> the text with secrets replaced by ***
  local s=$1 f v
  # The generated secrets of the showcase on this machine, by value.
  for f in "$SC_HOME"/secrets/*; do
    [ -s "$f" ] || continue
    v=$(cat "$f"); s=${s//"$v"/***}
  done
  # Well-known token formats and credentials in URLs (case-sensitive).
  s=$(printf '%s' "$s" | sed -E -e 's/gh[pousr]_[A-Za-z0-9]{20,}/***/g' -e 's/github_pat_[A-Za-z0-9_]{20,}/***/g' \
    -e 's/AKIA[0-9A-Z]{16}/***/g' -e 's#://[^/[:space:]:@]+:[^/[:space:]@]+@#://***@#g')
  # Bearer/Basic credentials and key=value or key: value pairs with a secret name (any case).
  local had=0; shopt -q nocasematch && had=1; shopt -s nocasematch
  local re1='(bearer|basic)[[:space:]]+([^[:space:]*"'"'"']+)'
  local re2='(password|passwd|pwd|secret|token|api[_-]?key|access[_-]?key|authorization|credentials?)(["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"']?)([^[:space:]*"'"'"',;&]+)'
  while [[ $s =~ $re1 ]]; do s=${s/"${BASH_REMATCH[0]}"/"${BASH_REMATCH[1]} ***"}; done
  while [[ $s =~ $re2 ]]; do s=${s/"${BASH_REMATCH[0]}"/"${BASH_REMATCH[1]}${BASH_REMATCH[2]}***"}; done
  [ "$had" = 1 ] || shopt -u nocasematch
  printf '%s' "$s"
}

step_excerpt() { # log -> one line of the output of a failed step: the first with FAIL or ERROR, else the last non-empty one
  local clean line
  clean=$(sed -e $'s/\033\\[[0-9;]*[A-Za-z]//g' -e $'s/\r//g' "$1" 2>/dev/null || true)
  line=$(printf '%s\n' "$clean" | grep -E 'FAIL|ERROR|Error:' | head -1 || true)
  [ -n "$line" ] || line=$(printf '%s\n' "$clean" | grep -v '^[[:space:]]*$' | tail -1 || true)
  line=${line//$'\t'/ }; line=${line#"${line%%[![:space:]]*}"}
  line=$(mask_secrets "$line")
  printf '%s' "${line:0:300}"
}

fcd_secret() { # name: a generated secret per showcase on this machine, never in git (mode 600)
  local f="$SC_HOME/secrets/$1"
  if [ ! -s "$f" ]; then
    mkdir -p "$SC_HOME/secrets"; chmod 700 "$SC_HOME/secrets"
    (umask 077; LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32 >"$f")
  fi
  cat "$f"
}

container_var() { printf '%s_VERSION' "$(printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_')"; }

# ---------------------------------------------------------------- steps and gates (from the configuration)

GATE_REASONS=""   # reasons collected by the steps for the next gate
STEP_REASON=""    # reason of the current step (failed or skipped)
STEP_SKIPPED=0

gate_fail() { GATE_REASONS="${GATE_REASONS:+$GATE_REASONS; }$*"; STEP_REASON="${STEP_REASON:+$STEP_REASON; }$*"; }
warn()      { R_WARNINGS="${R_WARNINGS:+$R_WARNINGS; }$*"; info "  waarschuwing: $*"; }

threshold() { cfg QualityGate "$1" "spec/thresholds/$2" "${3:-}"; }   # gate path [default]

run_step() { # number name [container]: a step for the sub-product, or for one of its containers (Step.spec.level: container)
  local n=$1 name=$2 title fn t0 rc outcome dur
  R_CONTAINER=${3:-}
  title=$(cfg Step "$name" metadata/title "$name")
  fn="step_$(printf '%s' "$name" | tr '-' '_')"
  local log="$R_DIR/step-$n-$name${R_CONTAINER:+-$R_CONTAINER}.log"
  STEP_REASON=""; STEP_SKIPPED=0
  say "${C_B}[$n/$R_STEP_COUNT] $title${R_CONTAINER:+ ($R_CONTAINER)}${C_0}"
  emit "dev.cdevents.taskrun.started.0.2.0" "$name" "$(printf '{"taskName":%s,"step":%s,"title":%s,"pipelineRun":{"id":%s},"outcome":"running"%s}' "$(json_str "$name")" "$n" "$(json_str "$title")" "$(json_str "$R_ID")" "$(container_json)")"
  t0=$(now_s)
  local before="$GATE_REASONS"
  set +e
  if has "$fn"; then ( set -e; "$fn" ) >"$log" 2>&1 <&-; rc=$?
  else echo "step $name is not implemented in the Pipeline" >"$log"; rc=1; STEP_REASON="stap $name bestaat niet in de Pipeline (issue)"; fi
  set -e
  # state written by the subshell
  [ -f "$R_DIR/.step-state" ] && . "$R_DIR/.step-state" && rm -f "$R_DIR/.step-state"
  dur=$(( $(now_s) - t0 ))
  if [ "$STEP_SKIPPED" = 1 ]; then outcome=skipped; info "  overgeslagen: $STEP_REASON"
  elif [ $rc -ne 0 ] || [ "$GATE_REASONS" != "$before" ]; then
    outcome=failed
    [ -n "$STEP_REASON" ] || STEP_REASON="stap mislukt (exit $rc), zie $log"
    [ "$GATE_REASONS" != "$before" ] || GATE_REASONS="${GATE_REASONS:+$GATE_REASONS; }$title: $STEP_REASON"
    bad "  $STEP_REASON"; tail -15 "$log" | sed 's/^/    /'
  else outcome=succeeded; ok "  gelukt (${dur}s)"; fi
  local excerpt=""
  [ "$outcome" = failed ] && [ "$R_LIVE" = 1 ] && excerpt=",\"excerpt\":$(json_str "$(step_excerpt "$log")")"
  emit "dev.cdevents.taskrun.finished.0.2.0" "$name" "$(printf '{"taskName":%s,"step":%s,"title":%s,"pipelineRun":{"id":%s},"outcome":%s,"reason":%s%s%s}' "$(json_str "$name")" "$n" "$(json_str "$title")" "$(json_str "$R_ID")" "$(json_str "$outcome")" "$(json_str "$STEP_REASON")" "$excerpt" "$(container_json)")" "$dur"
  R_CONTAINER=""
}

# A step runs in a subshell; it passes results back through this file.
step_state() { printf '%s=%q\n' "$1" "$2" >>"$R_DIR/.step-state"; }
s_fail() { gate_fail "$*"; step_state GATE_REASONS "$GATE_REASONS"; step_state STEP_REASON "$STEP_REASON"; }
s_skip() { step_state STEP_SKIPPED 1; step_state STEP_REASON "$*"; }
s_warn() { step_state R_WARNINGS "${R_WARNINGS:+$R_WARNINGS; }$*"; R_WARNINGS="${R_WARNINGS:+$R_WARNINGS; }$*"; }
has() { declare -F "$1" >/dev/null; }

gate() { # name after_steps (as text for the log line)
  # An approved explain covers only the reasons that contain its rule; any other reason closes the gate.
  local name=$1 after=$2 outcome=open reason="" explains="" open_reasons="" r id nl=$'\n'
  gate_started "$name" afterSteps "$after"
  if [ -n "$GATE_REASONS" ]; then
    while IFS= read -r r; do
      [ -n "$r" ] || continue
      id=$(explain_for "$name" "$r")
      if [ -n "$id" ]; then
        case ",$explains," in *",$id,"*) ;; *) explains="${explains:+$explains,}$id" ;; esac
        reason="${reason:+$reason; }afwijking $id: $r"
      else
        open_reasons="${open_reasons:+$open_reasons; }$r"
      fi
    done <<EOF_REASONS
${GATE_REASONS//; /$nl}
EOF_REASONS
    if [ -n "$open_reasons" ]; then outcome=closed; reason="$open_reasons${reason:+; $reason}"; fi
  fi
  local details="" x
  for x in ${explains//,/ }; do details="${details:+$details,}$(explain_json "$x")"; done
  emit "dev.cdeventsx.fcd-qualitygate.evaluated.0.1.0" "$name-gate" "$(printf '{"gate":%s,"afterSteps":%s,"outcome":%s,"reason":%s,"explain":%s,"explainDetails":[%s]}' "$(json_str "$name")" "$(json_str "$after")" "$(json_str "$outcome")" "$(json_str "$reason")" "$(json_str "$explains")" "$details")"
  GATE_REASONS=""
  if [ "$outcome" = closed ]; then
    bad "${C_B}$name-gate dicht${C_0}: $reason"
    finish_run failure "$name-gate dicht: $reason"
    exit 1
  fi
  ok "${C_B}$name-gate open${C_0}${reason:+ ($reason)}"
}

explain_json() { # id -> {"id","gate","rule","reason","approver","until"} from the configuration
  local field out=""
  for field in gate rule reason approver until; do out="$out,$(json_str "$field"):$(json_str "$(cfg Explanation "$1" "spec/$field")")"; done
  printf '{"id":%s%s}' "$(json_str "$1")" "$out"
}

explain_for() { # gate reason -> id of an approved, not expired explain (configuration) whose rule is part of the reason
  local id today; today=$(date -u +%Y-%m-%d)
  for id in $(cfg_names Explanation); do
    local g rule appr until subject
    g=$(cfg Explanation "$id" spec/gate); rule=$(cfg Explanation "$id" spec/rule)
    appr=$(cfg Explanation "$id" spec/approver); until=$(cfg Explanation "$id" spec/until); subject=$(cfg Explanation "$id" spec/subject)
    [ "$g" = "$1" ] && [ -n "$rule" ] && [ -n "$appr" ] || continue
    # subject: one repository, or subjects: a list (empty = every repository of the showcase)
    if [ -n "$subject" ]; then [ "$subject" = "$R_NAME" ] || continue
    elif cfg_list Explanation "$id" spec/subjects | grep -q .; then cfg_list Explanation "$id" spec/subjects | grep -qx "$R_NAME" || continue; fi
    [ -z "$until" ] || [ ! "$until" \< "$today" ] || continue
    case "$2" in *"$rule"*) printf '%s' "$id"; return ;; esac
  done
}

# -- step implementations, keyed by the name of the Step in the configuration.
# A repository says how its product is linted, tested and built in ci/steps.sh (ci_lint, ci_unit, ci_freshness, CI_*).

step_static_check() { # lint + version consistency (per container: lint of that container; the versions once)
  if has ci_lint; then
    ci_lint "$R_CONTAINER" || [ "$(threshold code lintErrors/max 0)" != 0 ] || s_fail "lint-fouten (zie log)"
  else s_warn "geen lint ingesteld"; fi
  if [ -z "$R_CONTAINER" ] || [ "$R_CONTAINER" = "${R_CONTAINERS%% *}" ]; then
    [ "$(threshold code versionsConsistent true)" = true ] && check_versions
  fi
  return 0
}

check_versions() {
  local tag; tag=$(last_tag "$R_REPO")
  [ -n "$tag" ] || { echo "no previous release: version check against nothing"; return 0; }
  local old_sp new_sp c var old new changed=""
  old_sp=$(ver_at_ref "$R_REPO" "$tag" SUBPRODUCT_VERSION); new_sp=$R_VERSION
  for c in $R_CONTAINERS; do
    var=$(container_var "$c"); old=$(ver_at_ref "$R_REPO" "$tag" "$var"); new=$(ver_get "$R_REPO" "$var")
    [ -z "$old" ] && continue
    if ver_gt "$old" "$new"; then s_fail "versie $c gaat omlaag ($old -> $new)"; fi
    if ver_gt "$new" "$old"; then changed="$changed $c"; fi
  done
  if [ -n "$changed" ] && ! ver_gt "$new_sp" "$old_sp"; then
    s_fail "container(s)$changed hebben een nieuwe versie, $R_SUBPRODUCT niet (nog $new_sp)"
  fi
  if ver_gt "$new_sp" "$old_sp" && [ -z "$(changelog_heading "$R_REPO" "$new_sp")" ]; then
    s_fail "CHANGELOG.md heeft geen kop voor $new_sp"
  fi
  if [ "$R_RELEASE_TYPE" = emergency ] && changelog_heading "$R_REPO" "$new_sp" | grep -qi security; then
    grep -q "$new_sp" "$R_REPO/SECURITY.md" || s_fail "noodpatch om security zonder regel in SECURITY.md"
  fi
  echo "versions consistent with $tag"
}

step_unit_tests() { # reports as JUnit XML in reports/unit (per container: reports/unit/<container>)
  has ci_unit || { s_skip "geen unittests ingesteld"; return 0; }
  ci_unit "$R_CONTAINER"
  report_tests unit "$R_DIR/reports/unit${R_CONTAINER:+/$R_CONTAINER}" "$(threshold code unitTestsFailed/max 0)"
}

report_tests() { # kind dir max_failed: sum all JUnit XML, emit testsuiterun.finished, fail above the threshold
  local kind=$1 dir=$2 max=${3:-0} counts tests failed skipped time failures outcome
  counts=$(junit_counts "$dir")
  read -r tests failed skipped time <<<"$counts"
  failures=$(junit_failures "$dir")
  outcome=pass; [ "$failed" -gt 0 ] && outcome=fail
  [ "$tests" -eq 0 ] && outcome=fail && failures="geen testresultaten gevonden"
  emit "dev.cdevents.testsuiterun.finished.0.2.0" "$kind" \
    "$(printf '{"testSuite":{"id":%s,"name":%s},"testType":%s,"outcome":%s,"tests":%s,"passed":%s,"failed":%s,"skipped":%s,"seconds":%s,"failures":%s,"reportDir":%s%s}' \
      "$(json_str "$R_NAME-$kind${R_CONTAINER:+-$R_CONTAINER}")" "$(json_str "$kind")" "$(json_str "$kind")" "$(json_str "$outcome")" \
      "$tests" "$(( tests - failed - skipped ))" "$failed" "$skipped" "$time" "$(json_str "$failures")" "$(json_str "${dir#"$R_REPO"/}")" "$(container_json)")" "$time"
  echo "$kind: $tests tests, $failed failed, $skipped skipped (${time}s)"
  if [ "$tests" -eq 0 ] || [ "$failed" -gt "$max" ]; then s_fail "$kind: $failed van $tests tests mislukt${failures:+ ($failures)}"; fi
}

junit_counts() { # dir -> "tests failed skipped seconds" (from <testsuite> elements)
  find "$1" -name '*.xml' -type f -print0 2>/dev/null | xargs -0 cat 2>/dev/null | awk '
    function attr(s, a,   m) { if (match(s, a "=\"[^\"]*\"")) { m = substr(s, RSTART + length(a) + 2, RLENGTH - length(a) - 3); return m + 0 } return 0 }
    { while (match($0, /<testsuite[ >][^>]*>/)) { e = substr($0, RSTART, RLENGTH); $0 = substr($0, RSTART + RLENGTH)
        t += attr(e, "tests"); f += attr(e, "failures") + attr(e, "errors"); s += attr(e, "skipped"); d += attr(e, "time") } }
    END { printf "%d %d %d %.1f\n", t, f, s, d }'
}

junit_failures() { # names of failed test cases, comma separated (max 5)
  find "$1" -name '*.xml' -type f -print0 2>/dev/null | xargs -0 cat 2>/dev/null | awk '
    /<testcase/ { if (match($0, /name="[^"]*"/)) name = substr($0, RSTART + 6, RLENGTH - 7) }
    /<(failure|error)[ >]/ { if (n < 5) { out = out (n ? ", " : "") name; n++ } }
    END { print out }'
}

unit_from_dockerfile() { # name context [dockerfile] [build-arg...]: export target test-reports
  local name=$1 ctx=$2 df=${3:-}; shift 3 || shift $#
  local args=""
  [ -n "$df" ] && args="-f $R_REPO/$df"
  # shellcheck disable=SC2086
  docker build --target test-reports --output "type=local,dest=$R_DIR/reports/unit/$name" $args "$@" "$R_REPO/$ctx"
}

contracts_of_container() { # the contracts of this repository for the current container (Contract.spec.container);
  # a contract without a container goes with the last container, so none is left out
  local c own last="${R_CONTAINERS##* }"
  for c in $(contracts_of_repo); do
    own=$(cfg Contract "$c" spec/container "")
    if [ -z "$R_CONTAINER" ] || [ "$own" = "$R_CONTAINER" ] || { [ -z "$own" ] && [ "$R_CONTAINER" = "$last" ]; }; then printf '%s\n' "$c"; fi
  done
}

contracts_of_repo() { # the contracts of this repository (configuration: Contract.spec.repository)
  local c; for c in $(cfg_names Contract); do [ "$(cfg Contract "$c" spec/repository)" = "$R_NAME" ] && printf '%s\n' "$c"; done; return 0
}
contract_version() { # dir file type -> the version in the contract itself (OpenAPI info.version, JSON Schema x-version)
  local q='.info.version' p=yaml; [ "$3" = JSON ] && { q='."x-version"'; p=json; }
  docker run --rm -v "$1":/c:ro "$TOOL_YQ" -p "$p" "$q" "/c/$2" 2>/dev/null | grep -v '^null$' || true
}

# -- API-register (Apicurio Registry, one per showcase): group = showcase, artifact = contract name
registry_up_ok() { curl -fsS -m 3 -o /dev/null "$FCD_REGISTRY_URL/system/info" 2>/dev/null; }
registry_call() { # method path [body] -> prints "status body"
  local out code; out=$(mktemp)
  code=$(curl -sS -m 20 -o "$out" -w '%{http_code}' -X "$1" -H 'Content-Type: application/json' ${3:+-d "$3"} "$FCD_REGISTRY_URL/groups/$SC_NAME$2" 2>/dev/null || echo 000)
  printf '%s %s' "$code" "$(tr -d '\n' <"$out" | cut -c1-400)"; rm -f "$out"
}
contract_content() { # name dir file type -> {"content": ..., "contentType": ..., "references": [...]}
  # References (configuration: Contract.spec.references): a $ref to another contract, such as ./logline.schema.json,
  # resolved by the register to that contract in the version that is in the same files.
  local name=$1 dir=$2 file=$3 type=$4 ct=application/x-yaml refs="" i ref rc rfile rtype rver
  [ "$type" = JSON ] && ct=application/json
  i=0
  while ref=$(cfg Contract "$name" "spec/references/$i/name"); [ -n "$ref" ]; do
    rc=$(cfg Contract "$name" "spec/references/$i/contract")
    rfile=$(cfg Contract "$rc" spec/file); rtype=$(cfg Contract "$rc" spec/type OPENAPI)
    rver=$(contract_version "$dir" "$rfile" "$rtype")
    refs="${refs:+$refs,}$(printf '{"name":%s,"groupId":%s,"artifactId":%s,"version":%s}' "$(json_str "$ref")" "$(json_str "$SC_NAME")" "$(json_str "$rc")" "$(json_str "$rver")")"
    i=$((i + 1))
  done
  printf '{"content":%s,"contentType":"%s","references":[%s]}' "$(json_str "$(cat "$dir/$file")")" "$ct" "$refs"
}
registry_meta() { # name -> artifact metadata from the configuration: title, description and labels (findable in the register)
  local name=$1 title repo sp s
  title=$(cfg Contract "$name" metadata/title "$name"); repo=$(cfg Contract "$name" spec/repository)
  sp=$repo
  for s in $(cfg_names SubProduct); do [ "$(cfg SubProduct "$s" spec/repository)" = "$repo" ] && sp=$s; done
  printf '{"name":%s,"description":%s,"labels":{"showcase":%s,"repository":%s,"deelproduct":%s,"type":%s,"compatibility":%s}}' \
    "$(json_str "$title")" "$(json_str "$title ($repo, $(cfg Contract "$name" spec/file))")" "$(json_str "$SC_NAME")" "$(json_str "$repo")" \
    "$(json_str "$sp")" "$(json_str "$(cfg Contract "$name" spec/type OPENAPI)")" "$(json_str "$(cfg Contract "$name" spec/compatibility BACKWARD)")"
}
registry_set_meta() { [ "$(registry_call PUT "/artifacts/$1" "$(registry_meta "$1")" | cut -d' ' -f1)" = 204 ]; }

registry_has() { [ "$(registry_call GET "/artifacts/$1/versions/$2" | cut -d' ' -f1)" = 200 ]; }
registry_add() { # name version dir file type dry -> prints "status body"; creates the artifact (with its rules) when it is new
  local name=$1 ver=$2 dir=$3 file=$4 type=$5 dry=${6:-} content r
  content=$(contract_content "$name" "$dir" "$file" "$type")
  if [ "$(registry_call GET "/artifacts/$name" | cut -d' ' -f1)" != 200 ]; then
    [ -n "$dry" ] && { printf '200 new contract'; return; }
    r=$(registry_call POST /artifacts "$(printf '{"artifactId":"%s","artifactType":"%s","firstVersion":{"version":"%s","content":%s}}' "$name" "$type" "$ver" "$content")")
    registry_set_meta "$name" || true
    registry_call POST "/artifacts/$name/rules" "$(printf '{"ruleType":"COMPATIBILITY","config":"%s"}' "$(cfg Contract "$name" spec/compatibility BACKWARD)")" >/dev/null
    # SYNTAX_ONLY: FULL cannot follow a $ref to a separate schema file (such as logline.openapi.yaml -> logline.schema.json).
    registry_call POST "/artifacts/$name/rules" '{"ruleType":"VALIDITY","config":"SYNTAX_ONLY"}' >/dev/null
    printf '%s' "$r"; return
  fi
  registry_call POST "/artifacts/$name/versions${dry:+?dryRun=true}" "$(printf '{"version":"%s","content":%s}' "$ver" "$content")"
}

step_contract_test() { # per contract of the configuration: lint, a new version when it changed, not broken (oasdiff, Apicurio)
  local contracts; contracts=$(contracts_of_container)
  [ -n "$contracts" ] || { s_skip "geen contract van ${R_CONTAINER:-deze repository} in de configuratie"; return 0; }
  local tag base="" base_major new_major registry=1
  tag=$(last_tag "$R_REPO")
  if [ -n "$tag" ]; then
    # The whole repository as it was at the previous release, so references between files ($ref) resolve.
    base="$R_DIR/contract-base"; rm -rf "$base"; mkdir -p "$base"
    git -C "$R_REPO" archive "$tag" | tar -x -C "$base"
    base_major=${tag#v}; base_major=${base_major%%.*}
  fi
  new_major=${R_VERSION%%.*}
  if ! registry_up_ok; then
    registry=0
    if [ -n "${FCD_SHOWCASE_OVERRIDE:-}" ]; then s_warn "API-register van showcase $SC_NAME niet bereikbaar (D1): geen controle in Apicurio"
    else s_fail "API-register niet bereikbaar op $FCD_REGISTRY_URL (fcd up)"; fi
  fi
  local c file type ver bver r
  for c in $contracts; do
    file=$(cfg Contract "$c" spec/file); type=$(cfg Contract "$c" spec/type OPENAPI)
    echo "== contract $c ($type, $file)"
    [ -f "$R_REPO/$file" ] || { s_fail "contract $c: $file ontbreekt"; continue; }
    if [ "$type" = OPENAPI ]; then
      docker run --rm -v "$R_REPO":/spec:ro -w /spec "$TOOL_REDOCLY" lint "$file" || [ "$(threshold code contractLintErrors/max 0)" != 0 ] || s_fail "contract $c: lint-fouten"
    fi
    ver=$(contract_version "$R_REPO" "$file" "$type")
    [ -n "$ver" ] || { s_fail "contract $c heeft geen versie"; continue; }
    bver=""
    if [ -n "$base" ] && [ -f "$base/$file" ]; then
      bver=$(contract_version "$base" "$file" "$type")
      if ! cmp -s "$base/$file" "$R_REPO/$file" && [ "$ver" = "$bver" ]; then
        s_fail "contract $c is veranderd zonder nieuwe versie (nog $ver)"
      fi
      if [ "$type" = OPENAPI ] && ! cmp -s "$base/$file" "$R_REPO/$file"; then
        echo "== breaking changes $c since $tag (oasdiff)"
        if ! docker run --rm -v "$R_REPO":/new:ro -v "$base":/base:ro "$TOOL_OASDIFF" breaking "/base/$file" "/new/$file" --fail-on ERR; then
          if [ "$new_major" -gt "$base_major" ]; then echo "breaking change with a new major version: allowed"
          elif [ "$(threshold code breakingChanges/withoutNewMajor 0)" != 0 ]; then echo "breaking change allowed by the threshold"
          else s_fail "contract $c $ver: brekende wijziging (oasdiff)"; fi
        fi
      fi
    fi
    [ "$registry" = 1 ] || continue
    # After a restart (storage in memory) the register is filled again from git: the version of the previous release.
    if [ -n "$bver" ] && ! registry_has "$c" "$bver"; then
      r=$(registry_add "$c" "$bver" "$base" "$file" "$type"); echo "register: $c $bver from $tag (${r%% *})"
    fi
    if registry_has "$c" "$ver"; then echo "register: $c $ver is registered"; continue; fi
    r=$(registry_add "$c" "$ver" "$R_REPO" "$file" "$type" dry)
    case "${r%% *}" in
      200) echo "register: $c $ver compatible ($(cfg Contract "$c" spec/compatibility BACKWARD))" ;;
      409|400) s_fail "contract $c $ver: niet $(cfg Contract "$c" spec/compatibility BACKWARD | tr '[:upper:]' '[:lower:]') compatibel volgens het API-register ($(printf '%s' "$r" | sed -n 's/.*"description":"\([^"]*\)".*/\1/p' | head -1))" ;;
      *) s_fail "contract $c $ver: API-register gaf ${r%% *}"; echo "$r" ;;
    esac
  done
}

register_contracts() { # after a release: every new version of a contract of this repository in the API-register
  registry_up_ok || { s_warn "API-register niet bereikbaar: contracten niet geregistreerd"; return 0; }
  local c file type ver r
  for c in $(contracts_of_repo); do
    file=$(cfg Contract "$c" spec/file); type=$(cfg Contract "$c" spec/type OPENAPI)
    ver=$(contract_version "$R_REPO" "$file" "$type")
    [ -n "$ver" ] && ! registry_has "$c" "$ver" || continue
    r=$(registry_add "$c" "$ver" "$R_REPO" "$file" "$type")
    case "${r%% *}" in 200) echo "register: $c $ver registered" ;; *) s_warn "contract $c $ver niet geregistreerd (${r%% *})" ;; esac
  done
}

compose_r() { # docker compose for the repository, project $1
  local p=$1; shift
  local files="" f
  for f in $CI_COMPOSE_FILES; do files="$files -f $R_REPO/$f"; done
  # shellcheck disable=SC2086
  docker compose -p "$p" --project-directory "$R_REPO" --env-file "$R_REPO/versions.env" $files "$@"
}

step_build() { # build the images, tags follow versions.env; fetch the images that are not built here
  [ -n "${CI_COMPOSE_FILES:-}" ] || { s_skip "geen containers in deze repository"; return 0; }
  if [ -z "$R_CONTAINER" ]; then
    compose_r "$R_PROJECT" pull --ignore-buildable --quiet
    compose_r "$R_PROJECT" build
    compose_r "$R_PROJECT" config --images
    return 0
  fi
  compose_r "$R_PROJECT" build "$R_CONTAINER"
  # The other services (such as stubs) are not part of the sub-product and have their own lifecycle:
  # built here only when their image is missing, so the sub-product can be tested and deployed with them.
  local svc img
  for svc in $(compose_r "$R_PROJECT" config --services); do
    case " $R_CONTAINERS " in *" $svc "*) continue ;; esac
    img=$(compose_r "$R_PROJECT" config --images "$svc" 2>/dev/null | head -1)
    if [ -n "$img" ] && ! docker image inspect "$img" >/dev/null 2>&1; then
      echo "== $svc: image $img ontbreekt, gebouwd (geen deel van $R_SUBPRODUCT)"
      compose_r "$R_PROJECT" build "$svc"
    fi
  done
  compose_r "$R_PROJECT" config --images "$R_CONTAINER"
}

ephemeral_up() {
  # A short-lived environment is never the deployed environment: what it measures (such as orders of tests) is werkplek.
  FCD_ENVIRONMENT=werkplek compose_r "$R_EPHEMERAL" -f "$R_REPO/ci/compose.ephemeral.yml" up -d --no-build --remove-orphans
  wait_ready "$R_EPHEMERAL"
}
ephemeral_down() { [ -n "${CI_COMPOSE_FILES:-}" ] && compose_r "$R_EPHEMERAL" -f "$R_REPO/ci/compose.ephemeral.yml" down -v --remove-orphans >/dev/null 2>&1 || true; }

wait_ready() { # project: probe CI_READY_URL inside the project network, within the threshold of the deploy gate
  local i max; max=$(threshold deploy readySeconds/max 60)
  for i in $(seq 1 "$max"); do
    if docker run --rm --network "${1}_default" "$TOOL_CURL" -fsS -o /dev/null "$CI_READY_URL" >/dev/null 2>&1; then echo "ready after ${i}s"; return 0; fi
    sleep 1
  done
  compose_r "$1" ps
  return 1
}

step_integration_tests() { # the sub-product with stubs in a short-lived environment; contract checks
  [ -n "${CI_CONTRACT_TARGETS:-}" ] || { s_skip "geen integratietests ingesteld"; return 0; }
  ephemeral_up || { s_fail "tijdelijke omgeving start niet"; return 0; }
  local t spec url name checks examples
  checks=$(cfg_list Step integration-tests spec/contractChecks | paste -sd, -)
  examples=$(cfg Step integration-tests spec/maxExamples 25)
  mkdir -p "$R_DIR/reports/integration"
  # Schemathesis has no usable live count: the count so far after every contract target.
  local c_tests c_failed c_skipped
  test_started integration
  for t in $CI_CONTRACT_TARGETS; do # name=spec@url
    name=${t%%=*}; spec=${t#*=}; spec=${spec%@*}; url=${t##*@}
    echo "== schemathesis $name: $spec against $url (checks: ${checks:-all})"
    docker run --rm --network "${R_EPHEMERAL}_default" -v "$R_REPO":/spec:ro -v "$R_DIR/reports/integration":/reports \
      "$TOOL_SCHEMATHESIS" run "/spec/$spec" --url "$url" --checks "${checks:-all}" --max-examples "$examples" --workers 1 \
      --report junit --report-junit-path "/reports/TEST-$name.xml" || true
    read -r c_tests c_failed c_skipped _ <<<"$(junit_counts "$R_DIR/reports/integration")"
    test_progressed integration "$(( c_tests - c_failed - c_skipped ))" "$c_failed" "$c_skipped"
  done
  report_tests integration "$R_DIR/reports/integration" "$(threshold build integrationTestsFailed/max 0)"
}

images() { compose_r "$R_PROJECT" config --images; }

step_security_freshness() { # vulnerabilities, secrets, configuration; freshness of libraries
  mkdir -p "$R_DIR/scan"
  local vsev msev fix=""
  vsev=$(cfg_list QualityGate security spec/thresholds/vulnerabilities/severities | paste -sd, -)
  msev=$(cfg_list QualityGate security spec/thresholds/misconfigurations/severities | paste -sd, -)
  [ "$(threshold security vulnerabilities/onlyWithFix true)" = true ] && fix=--ignore-unfixed
  # Trivy: exit code 3 = findings, anything else non-zero = the scan itself failed (both close the gate).
  echo "== repository: vulnerabilities ($vsev)"
  scan_r "repository: kwetsbaarheid ($vsev)" fs --exit-code 3 --severity "${vsev:-CRITICAL,HIGH}" --scanners vuln --offline-scan $fix --skip-dirs /repo/.fcd /repo
  echo "== repository: secrets"
  if [ "$(threshold security secrets/max 0)" = 0 ]; then
    scan_r "repository: geheim gevonden" fs --exit-code 3 --scanners secret --offline-scan --skip-dirs /repo/.fcd /repo
  fi
  echo "== repository: configuration ($msev)"
  scan_r "repository: misconfiguratie ($msev)" fs --exit-code 3 --severity "${msev:-CRITICAL,HIGH}" --scanners misconfig --offline-scan --skip-dirs /repo/.fcd /repo
  if [ -n "${CI_COMPOSE_FILES:-}" ]; then
    local img
    for img in $(images); do
      echo "== image $img"
      SCAN_IMAGE=$img
      if [ "$(cfg Step security-freshness spec/cache false)" != true ] || [ ! -f "$FCD_HOME/cache/security-freshness/$(scan_cache_key image --exit-code 3 --severity "${vsev:-CRITICAL,HIGH}" $fix --input /scan/image.tar).rc" ]; then
        docker save -o "$R_DIR/scan/image.tar" "$img"
      fi
      scan_r "image $img: kwetsbaarheid ($vsev)" image --exit-code 3 --severity "${vsev:-CRITICAL,HIGH}" $fix --input /scan/image.tar
      rm -f "$R_DIR/scan/image.tar"
    done
  fi
  echo "== freshness"
  freshness
}

freshness() { # the repository reports "freshness|part|name|current|latest"; the threshold is in the configuration
  has ci_freshness || { s_warn "geen versheidscontrole ingesteld"; return 0; }
  local rc=0 max undetermined
  max=$(threshold security freshness/maxMajorBehind 0); undetermined=$(threshold security freshness/undetermined warn)
  # The facts depend on the dependency files; a shortened step (Step.spec.cache) takes them from the cache.
  local key; key=$(git -C "$R_REPO" ls-files -s -- '*pom.xml' '*package.json' '*package-lock.json' | shasum -a 256 | cut -c1-32)
  local fdir="$FCD_HOME/cache/freshness"
  if [ "$(cfg Step security-freshness spec/cache false)" = true ] && [ -f "$fdir/$key.txt" ]; then
    echo "(versheid uit de cache van de voorbereiding: $key)"; cp "$fdir/$key.txt" "$R_DIR/freshness.txt"; rc=$(cat "$fdir/$key.rc")
  else
    ci_freshness >"$R_DIR/freshness.txt" || rc=$?
    if [ "$rc" = 0 ]; then mkdir -p "$fdir"; cp "$R_DIR/freshness.txt" "$fdir/$key.txt"; echo 0 >"$fdir/$key.rc"; fi
  fi
  cat "$R_DIR/freshness.txt"
  local parts part names minor
  parts=$(awk -F'|' '$1 == "freshness" { print $2 }' "$R_DIR/freshness.txt" | sort -u)
  while IFS= read -r part; do
    [ -n "$part" ] || continue
    names=$(awk -F'|' -v p="$part" -v m="$max" '$1 == "freshness" && $2 == p { split($4, a, "."); split($5, b, ".")
      if (b[1] - a[1] > m) printf " %s %s->%s", $3, $4, $5 }' "$R_DIR/freshness.txt")
    [ -z "$names" ] || s_fail "versheid $part: meer dan $max major-versie(s) achter:$names"
  done <<EOF_PARTS
$parts
EOF_PARTS
  minor=$(grep -c '^freshness|' "$R_DIR/freshness.txt" || true)
  [ "$minor" -gt 0 ] && s_warn "versheid: $minor libraries hebben een nieuwere versie"
  if [ "$rc" -ne 0 ]; then
    if [ "$undetermined" = closed ]; then s_fail "versheid niet te bepalen"; else s_warn "versheid niet te bepalen (netwerk?)"; fi
  fi
}

scan_cache_key() { # trivy-args... -> a key for what is scanned: the args, the content of the repository, or the image
  local what
  case " $* " in
    *" --input /scan/image.tar "*) what=$(docker image inspect --format '{{.Id}}' "$SCAN_IMAGE" 2>/dev/null || echo none) ;;
    *) what=$(git -C "$R_REPO" rev-parse 'HEAD^{tree}' 2>/dev/null || echo none) ;;
  esac
  printf '%s %s %s' "$TOOL_TRIVY" "$what" "$*" | shasum -a 256 | cut -c1-32
}

cached() { # step key command...: a shortened step (Step.spec.cache) takes a definite result (0 or 3) from the cache
  local step=$1 key=$2 dir rc=0; shift 2
  dir="$FCD_HOME/cache/$step"
  if [ "$(cfg Step "$step" spec/cache false)" = true ] && [ -f "$dir/$key.rc" ]; then
    echo "(uit de cache van de voorbereiding: $key)"; cat "$dir/$key.out"; return "$(cat "$dir/$key.rc")"
  fi
  "$@" >"$R_DIR/cached.out" 2>&1 || rc=$?
  cat "$R_DIR/cached.out"
  if [ "$rc" = 0 ] || [ "$rc" = 3 ] || [ "$rc" = 1 ]; then
    mkdir -p "$dir"; cp "$R_DIR/cached.out" "$dir/$key.out"; echo "$rc" >"$dir/$key.rc"
  fi
  return "$rc"
}

scan_r() { # reason trivy-args...: run a scan; findings (exit 3) or a failed scan close the gate, each with its own reason
  local reason=$1 rc=0; shift
  cached security-freshness "$(scan_cache_key "$@")" trivy_r "$@" || rc=$?
  case $rc in
    0) ;;
    3) s_fail "$reason" ;;
    *) s_fail "scan mislukt (${reason%%:*}), zie log" ;;
  esac
}

trivy_r() {
  docker run --rm -v "$R_REPO":/repo:ro -v "$R_DIR/scan":/scan -v fcd-trivy-cache:/root/.cache "$TOOL_TRIVY" --quiet "$@"
}

license_policy() { # the license policy of the security gate as a Trivy configuration (in $R_DIR/scan)
  local cat item
  {
    echo "license:"
    for cat in forbidden restricted allowed; do
      case $cat in allowed) echo "  permissive:" ;; *) echo "  $cat:" ;; esac
      cfg_list QualityGate security "spec/thresholds/licenses/$cat" | while IFS= read -r item; do echo "    - $item"; done
    done
    echo "  reciprocal: []"
    echo "  notice: []"
    echo "  unencumbered: []"
  } >"$R_DIR/scan/trivy-license.yaml"
}

step_sbom_licenses() { # SBOM (CycloneDX) per image and licenses
  [ -n "${CI_COMPOSE_FILES:-}" ] || { s_skip "geen images in deze repository"; return 0; }
  mkdir -p "$R_DIR/sbom" "$R_DIR/scan"
  license_policy
  local img file lib_sev="MEDIUM,HIGH,CRITICAL" os_sev="CRITICAL"
  [ "$(threshold security licenses/unknown closed)" = closed ] && lib_sev="UNKNOWN,$lib_sev"
  [ "$(threshold security licenses/restrictedInBaseImage allowed)" = allowed ] || os_sev="HIGH,CRITICAL"
  local cache="$FCD_HOME/cache/sbom-licenses" key
  for img in $(images); do
    file="$(printf '%s' "$img" | tr '/:' '__').cdx.json"
    # A shortened step (Step.spec.cache): the SBOM and the license check of the same image from the cache.
    key=$(printf '%s %s %s %s' "$TOOL_SYFT" "$TOOL_TRIVY" "$(docker image inspect --format '{{.Id}}' "$img")" "$(cat "$R_DIR/scan/trivy-license.yaml" "$R_DIR/scan/"*.yaml 2>/dev/null)" | shasum -a 256 | cut -c1-32)
    if [ "$(cfg Step sbom-licenses spec/cache false)" = true ] && [ -f "$cache/$key.rc" ]; then
      echo "== sbom en licenties $img (uit de cache van de voorbereiding: $key)"
      cp "$cache/$key.cdx.json" "$R_DIR/sbom/$file"
      [ "$(cat "$cache/$key.rc")" = 0 ] || s_fail "$(cat "$cache/$key.reason")"
      continue
    fi
    local before_fail="$GATE_REASONS"
    echo "== sbom $img"
    docker save -o "$R_DIR/scan/image.tar" "$img"
    docker run --rm -v "$R_DIR/scan":/scan -v "$R_DIR/sbom":/sbom "$TOOL_SYFT" scan "docker-archive:/scan/image.tar" \
      -o "$(cfg Step sbom-licenses spec/sbomFormat cyclonedx-json)=/sbom/$file" -q || s_fail "SBOM van $img mislukt"
    echo "== licenses $img (libraries)"
    trivy_r image --config /scan/trivy-license.yaml --scanners license --pkg-types library --exit-code 1 \
      --severity "$lib_sev" --input /scan/image.tar || s_fail "image $img: licentie niet toegestaan of onbekend"
    echo "== licenses $img (OS packages of the base image)"
    trivy_r image --config /scan/trivy-license.yaml --scanners license --pkg-types os --exit-code 1 \
      --severity "$os_sev" --input /scan/image.tar || s_fail "image $img: licentie in OS-pakket niet toegestaan"
    rm -f "$R_DIR/scan/image.tar"
    if [ -s "$R_DIR/sbom/$file" ]; then
      mkdir -p "$cache"; cp "$R_DIR/sbom/$file" "$cache/$key.cdx.json"
      if [ "$GATE_REASONS" = "$before_fail" ]; then echo 0 >"$cache/$key.rc"
      else echo 1 >"$cache/$key.rc"; printf '%s' "${GATE_REASONS#"$before_fail"}" | sed 's/^; //' >"$cache/$key.reason"; fi
    fi
  done
  ls -l "$R_DIR/sbom"
}

step_deploy() { # deploy the whole sub-product (configuration: Pipeline.spec.deployTarget)
  [ -n "${CI_COMPOSE_FILES:-}" ] || { s_skip "geen containers om uit te rollen"; return 0; }
  local target; target=$(cfg Pipeline "$R_PIPELINE" spec/deployTarget docker-compose)
  [ "$target" = docker-compose ] || { s_fail "uitrollen naar $target kan de Pipeline nog niet (issue)"; return 0; }
  if [ "$R_ENV" = werkplek ]; then
    echo "werkplek: the short-lived environment is the deployment for the end-to-end tests"
    ephemeral_up || { s_fail "tijdelijke omgeving start niet"; return 0; }
    step_state R_E2E_PROJECT "$R_EPHEMERAL"
    return 0
  fi
  compose_r "$R_PROJECT" up -d --no-build --remove-orphans
  wait_ready "$R_PROJECT" || { s_fail "$R_SUBPRODUCT niet bereikbaar binnen $(threshold deploy readySeconds/max 60) s"; return 0; }
  compose_r "$R_PROJECT" ps
  step_state R_E2E_PROJECT "$R_PROJECT"
  step_state R_DEPLOYED 1
}

step_end_to_end_tests() { # Playwright on the deployed sub-product
  [ -n "${CI_E2E_DIR:-}" ] || { s_skip "geen end-to-end tests ingesteld"; return 0; }
  local tag="fcd-e2e/$R_NAME:$R_VERSION"
  mkdir -p "$R_DIR/reports/e2e"; chmod 777 "$R_DIR/reports/e2e"
  docker build -t "$tag" "$R_REPO/$CI_E2E_DIR"
  local expected="" out="$R_DIR/e2e-output.log" pid grep=() pattern
  # Only some tests (configuration: Step.spec.grep), such as the core path in the demo (with an approved explain).
  pattern=$(cfg Step end-to-end-tests spec/grep "")
  [ -n "$pattern" ] && grep=(--grep "$pattern") && echo "only the tests matching $pattern (Step.spec.grep)"
  if [ "$R_LIVE" = 1 ]; then
    expected=$(docker run --rm --read-only --tmpfs /tmp --cap-drop ALL --security-opt no-new-privileges:true "$tag" --list "${grep[@]}" 2>/dev/null \
      | sed -n 's/^Total: \([0-9][0-9]*\) test.*/\1/p' | tail -1 || true)
  fi
  test_started end-to-end "$expected"
  : >"$out"
  docker run --rm --network "${R_E2E_PROJECT:-$R_PROJECT}_default" \
    --read-only --tmpfs /tmp --cap-drop ALL --security-opt no-new-privileges:true --shm-size 1g \
    -v "$R_DIR/reports/e2e":/reports -e PLAYWRIGHT_JUNIT_OUTPUT_FILE=/reports/TEST-e2e.xml \
    "$tag" --reporter=list,junit "${grep[@]}" >"$out" 2>&1 &
  pid=$!
  [ "$R_LIVE" = 1 ] && watch_progress end-to-end "$out" "$pid" playwright_counts
  wait "$pid" || true
  cat "$out"
  report_tests end-to-end "$R_DIR/reports/e2e" "$(threshold deploy endToEndTestsFailed/max 0)"
}

step_release() { # git tag + GitHub Release with the text from CHANGELOG.md (configuration: Pipeline.spec.release)
  [ "$R_ENV" = lokaal ] || { s_skip "alleen na een merge op main (agent)"; return 0; }
  [ "$R_RELEASE" = 1 ] || { s_skip "geen nieuwe versie (mensgate niet van toepassing)"; return 0; }
  local pattern tag notes="$R_DIR/release-notes.md"
  pattern=$(cfg Pipeline "$R_PIPELINE" spec/release/tag "v{version}"); tag=${pattern//\{version\}/$R_VERSION}
  changelog_section "$R_REPO" "$R_VERSION" >"$notes"
  [ -s "$notes" ] || { s_fail "geen tekst voor $R_VERSION in CHANGELOG.md"; return 0; }
  git -C "$R_REPO" tag -a "$tag" -m "$R_SUBPRODUCT $R_VERSION" "$R_SHA"
  git -C "$R_REPO" push origin "$tag"
  local repo_url; repo_url=$(git -C "$R_REPO" remote get-url origin)
  if [ "$(cfg Pipeline "$R_PIPELINE" spec/release/githubRelease true)" != true ]; then echo "no GitHub Release (configuration)"
  elif ! printf '%s' "$repo_url" | grep -qE '^(https://github\.com/|git@github\.com:)'; then
    # Every git host works (exit strategy): without GitHub only the tag, the notes stay in CHANGELOG.md.
    s_warn "origin is geen GitHub-repository: alleen de git-tag $tag, geen GitHub Release"
  elif command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then
    gh release create "$tag" --repo "$repo_url" --title "$R_SUBPRODUCT $R_VERSION" --notes-file "$notes" --verify-tag
  else
    s_warn "gh ontbreekt: alleen de git-tag, geen GitHub Release"
  fi
  register_contracts
  step_state R_RELEASED 1
  step_state R_TAG "$tag"
}

# ---------------------------------------------------------------- ci

start_run() { # repo env showcase-dir
  R_REPO=$(cd "$1" && pwd); R_ENV=$2
  [ -f "$R_REPO/versions.env" ] || die "$R_REPO: geen versions.env"
  R_NAME=$(basename "$(git -C "$R_REPO" remote get-url origin 2>/dev/null || echo "$R_REPO")" .git)
  R_PRODUCT=$(ver_get "$R_REPO" PRODUCT); R_SUBPRODUCT=$(ver_get "$R_REPO" SUBPRODUCT); R_VERSION=$(ver_get "$R_REPO" SUBPRODUCT_VERSION)
  # Release tags are needed for the version and contract checks, also before a push.
  git -C "$R_REPO" fetch -q --tags origin 2>/dev/null || true
  R_SHA=$(git -C "$R_REPO" rev-parse --short HEAD)
  R_ID="$R_NAME-$(date -u +%Y%m%d-%H%M%S)-$R_SHA"
  R_DIR="$R_REPO/.fcd/runs/$R_ID"; mkdir -p "$R_DIR/reports"
  # The configuration of the showcase this repository belongs to.
  local sc=${3:-${FCD_SHOWCASE_DIR:-}}
  [ -n "$sc" ] || sc=$(showcase_for_repo "$R_NAME" "$R_REPO")
  if [ -z "$sc" ]; then
    case "$R_NAME" in
      fcd-pipeline|fcd-dashboard)
        # D1 (interim): FCD's own sub-products, until their configuration is in fcd (issue in fcd).
        export FCD_SHOWCASE_OVERRIDE=fcd; sc="$FCD_ROOT/fcd-demo"
        info "D1: configuratie van FCD zelf staat nog niet in fcd; de configuratie van fcd-demo, showcase fcd" ;;
      *) die "$R_NAME hoort bij geen showcase: geen fcd-*/fcd/*.fcd.yaml met repository: $R_NAME (of geef --showcase)" ;;
    esac
  fi
  showcase_load "$sc" "$R_DIR/config.props"
  R_PIPELINE=$(cfg_first Pipeline)
  R_STEPS=$(cfg_list Pipeline "$R_PIPELINE" spec/steps)
  R_STEP_COUNT=$(printf '%s\n' "$R_STEPS" | grep -c .)
  R_LIVE=0; ver_ge "$(dashboard_version)" "$LIVE_SINCE_DASHBOARD" && R_LIVE=1
  R_V05=0; ver_ge "$(dashboard_version)" "$V05_SINCE_DASHBOARD" && R_V05=1
  local ts; ts=$(git -C "$R_REPO" log -1 --format=%at HEAD^2 2>/dev/null || git -C "$R_REPO" log -1 --format=%at HEAD)
  R_COMMIT_TIME=$(date -u -r "$ts" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$ts" +%Y-%m-%dT%H:%M:%SZ)
  R_PROJECT="$SC_PREFIX-$R_SUBPRODUCT"
  R_EPHEMERAL="$R_PROJECT-ci-$(printf '%s' "$R_SHA" | tr -cd 'a-z0-9')"
  R_EXPERIMENT=${FCD_EXPERIMENT:-$(experiment_of)}
  R_WARNINGS=""; R_RELEASE=0; R_RELEASED=0; R_DEPLOYED=0; R_E2E_PROJECT=""; R_TAG=""
  R_RELEASE_TYPE=planned
  changelog_heading "$R_REPO" "$R_VERSION" | grep -qi noodpatch && R_RELEASE_TYPE=emergency
  trigger_of_head
  CI_COMPOSE_FILES=""; CI_CONTRACT_TARGETS=""; CI_E2E_DIR=""; CI_READY_URL=""; CI_SUBPRODUCT_CONTAINERS=""
  # shellcheck source=/dev/null
  [ -f "$R_REPO/ci/steps.sh" ] && . "$R_REPO/ci/steps.sh"
  R_CONTAINERS=$CI_SUBPRODUCT_CONTAINERS
  # The deployed containers know their showcase, experiment and environment (key-result measurement).
  export FCD_EXPERIMENT="$R_EXPERIMENT" FCD_ENVIRONMENT="$R_ENV"
  trap 'ephemeral_down' EXIT
}

trigger_of_head() {
  if [ -n "${FCD_TRIGGER_KIND:-}" ]; then R_TRIGGER_KIND=$FCD_TRIGGER_KIND; R_TRIGGER_NAME=${FCD_TRIGGER_NAME:-unknown}; return; fi
  # The trigger is who made HEAD: for a merge on main that is the person who merged (a human),
  # for a commit before a push it can be an AI agent (Co-Authored-By) or an automatic update.
  local author msg
  author=$(git -C "$R_REPO" log -1 --format=%an HEAD); msg=$(git -C "$R_REPO" log -1 --format=%B HEAD)
  if [ "$R_ENV" = werkplek ]; then R_TRIGGER_NAME=$(git -C "$R_REPO" config user.name || whoami)
  else R_TRIGGER_NAME=$author; fi
  R_TRIGGER_KIND=human
  case "$author" in *dependabot*|*renovate*) R_TRIGGER_KIND=automated-update ;; esac
  if [ "$R_TRIGGER_KIND" = human ] && printf '%s' "$msg" | grep -qi 'Co-Authored-By: Claude'; then
    R_TRIGGER_KIND=ai-agent; R_TRIGGER_NAME="Claude Code (met $R_TRIGGER_NAME)"
  fi
}

finish_run() { # outcome reason
  local dur=$(( $(now_s) - R_T0 ))
  emit "dev.cdevents.pipelinerun.finished.0.2.0" "$R_ID" "$(printf '{"pipelineName":%s,"outcome":%s,"errors":%s,"warnings":%s,"url":%s}' "$(json_str "$R_NAME")" "$(json_str "$1")" "$(json_str "${2:-}")" "$(json_str "$R_WARNINGS")" "$(json_str "${R_DIR#"$R_REPO"/}")")" "$dur"
  say ""; say "run $R_ID: $1 (${dur}s)"; info "log lines: $R_DIR/events.jsonl"
}

gates_after() { # step -> the gates whose last step (in the order of the pipeline) is this step
  local g s last
  for g in $(cfg_names QualityGate); do
    last=""
    for s in $(cfg_list QualityGate "$g" spec/afterSteps); do
      printf '%s\n' "$R_STEPS" | grep -qx "$s" && last=$s
    done
    [ "$last" = "$1" ] && printf '%s\n' "$g"
  done
}
gates_before() { # step -> the gates that come before this step (such as the human gate before releasing)
  local g
  for g in $(cfg_names QualityGate); do cfg_list QualityGate "$g" spec/beforeSteps | grep -qx "$1" && printf '%s\n' "$g"; done
  return 0
}

cmd_ci() {
  local repo="." env=werkplek until=999 sc=""
  while [ $# -gt 0 ]; do
    case $1 in
      --env) env=$2; shift 2 ;;
      --until) until=$2; shift 2 ;;
      --showcase) sc=$2; shift 2 ;;
      -*) die "onbekende optie $1" ;;
      *) repo=$1; shift ;;
    esac
  done
  case $env in werkplek|lokaal) ;; *) die "--env werkplek of lokaal" ;; esac
  start_run "$repo" "$env" "$sc"
  R_T0=$(now_s)
  say "${C_B}fcd ci${C_0} $R_NAME $R_SUBPRODUCT $R_VERSION @ $R_SHA (showcase $SC_NAME, omgeving $R_ENV, $R_TRIGGER_KIND: $R_TRIGGER_NAME, $R_RELEASE_TYPE)"
  emit "dev.cdevents.pipelinerun.started.0.2.0" "$R_ID" "$(printf '{"pipelineName":%s,"outcome":"running"%s}' "$(json_str "$R_NAME")" "$(run_steps_json "$until")")"
  local n=0 step g
  for step in $R_STEPS; do
    n=$((n + 1))
    [ "$n" -le "$until" ] || break
    for g in $(gates_before "$step"); do human_gate "$g" "$step"; done
    if [ "$(cfg Step "$step" spec/level subProduct)" = container ] && [ -n "$R_CONTAINERS" ]; then
      local c; for c in $R_CONTAINERS; do run_step "$n" "$step" "$c"; done
    else
      run_step "$n" "$step"
    fi
    for g in $(gates_after "$step"); do gate "$g" "$(cfg_list QualityGate "$g" spec/afterSteps | paste -sd, -)"; done
    if [ "$step" = deploy ] && [ "$R_DEPLOYED" = 1 ]; then
      emit_deployed
    fi
    if [ "$step" = release ] && [ "$R_RELEASED" = 1 ]; then
      emit "dev.cdevents.artifact.published.0.2.0" "$R_SUBPRODUCT" "$(printf '{"tag":%s,"releaseType":%s}' "$(json_str "$R_TAG")" "$(json_str "$R_RELEASE_TYPE")")"
    fi
  done
  if [ -n "$GATE_REASONS" ]; then finish_run failure "$GATE_REASONS"; exit 1; fi
  finish_run success ""
}

emit_deployed() { # service.deployed, with the changelog up to this version for a Dashboard that shows it (contract 0.5.0)
  local changelog=""
  [ "$R_V05" = 1 ] && changelog=",\"changelog\":$(json_str "$(changelog_until "$R_REPO" "$R_VERSION")")"
  emit "dev.cdevents.service.deployed.0.2.0" "$R_SUBPRODUCT" "$(printf '{"environment":{"id":%s},"artifactId":%s%s}' "$(json_str "$R_ENV")" "$(json_str "pkg:git/$R_NAME@$R_SHA")" "$changelog")"
}

run_steps_json() { # until -> ,"steps":[...]: the names of the steps of this run, in order (only for a Dashboard that knows them)
  [ "$R_LIVE" = 1 ] || return 0
  local n=0 step out=""
  for step in $R_STEPS; do
    n=$((n + 1)); [ "$n" -le "$1" ] || break
    out="${out:+$out,}$(json_str "$step")"
  done
  printf ',"steps":[%s]' "$out"
}

human_gate() { # gate step: approval by a human (configuration: QualityGate.spec.approval)
  local approval; approval=$(cfg QualityGate "$1" spec/approval)
  case $approval in
    merge-on-main-with-higher-version) human_gate_merge "$1" ;;
    dashboard-button) human_gate_button "$1" "$2" ;;
    *) die "goedkeuring '$approval' kan de Pipeline nog niet (issue)" ;;
  esac
}

gate_open() { # gate before_steps reason: a human gate that opens
  emit "dev.cdeventsx.fcd-qualitygate.evaluated.0.1.0" "$1-gate" "$(printf '{"gate":%s,"afterSteps":"","beforeSteps":%s,"outcome":"open","reason":%s,"explain":"","explainDetails":[]}' "$(json_str "$1")" "$(json_str "$2")" "$(json_str "$3")")"
  ok "${C_B}$1-gate open${C_0}: $3"
}

human_gate_button() { # gate step: the product owner presses a button on the Dashboard, to start the run and before releasing
  local g=$1 step=$2 approver tag old
  approver=$(cfg QualityGate "$g" spec/approver "product owner")
  tag=$(last_tag "$R_REPO"); old=${tag#v}
  if [ "$step" = "$(printf '%s\n' "$R_STEPS" | head -1)" ]; then
    # The start: this run exists because someone pressed the start button. On the werkplek there is no button.
    [ "$R_ENV" = lokaal ] || return 0
    gate_started "$g" beforeSteps "$step"
    gate_open "$g" "$step" "gestart door $R_TRIGGER_NAME (knop op het Dashboard)"
    return 0
  fi
  if [ -n "$tag" ] && ! ver_gt "$R_VERSION" "$old"; then info "geen nieuwe versie ($R_VERSION = $tag): niet releasen"; return 0; fi
  if [ "$R_ENV" = werkplek ]; then
    [ "$R_LIVE" = 1 ] || return 0
    gate_started "$g" beforeSteps "$step" "$(printf '{"kind":"human","name":%s,"action":"merge op main met een hogere versie"}' "$(json_str "$approver")")"
    info "$g-gate wacht op $approver: merge op main met een hogere versie ($R_VERSION)"
    return 0
  fi
  local action="release $R_SUBPRODUCT $R_VERSION goedkeuren op het Dashboard"
  gate_started "$g" beforeSteps "$step" "$(printf '{"kind":"human","name":%s,"action":%s}' "$(json_str "$approver")" "$(json_str "$action")")"
  say "$g-gate wacht op $approver: $action"
  local t0 line id by; t0=$(now_s)
  while :; do
    line=$(command_claim approve-release "$R_ID")
    [ -n "$line" ] && break
    if [ $(( $(now_s) - t0 )) -ge "$FCD_APPROVAL_TIMEOUT" ]; then
      emit "dev.cdeventsx.fcd-qualitygate.evaluated.0.1.0" "$g-gate" "$(printf '{"gate":%s,"afterSteps":"","beforeSteps":%s,"outcome":"closed","reason":%s,"explain":"","explainDetails":[]}' "$(json_str "$g")" "$(json_str "$step")" "$(json_str "niet goedgekeurd binnen $FCD_APPROVAL_TIMEOUT s")")"
      bad "${C_B}$g-gate dicht${C_0}: niet goedgekeurd binnen $FCD_APPROVAL_TIMEOUT s"
      finish_run failure "$g-gate dicht: niet goedgekeurd"
      exit 1
    fi
    sleep 1
  done
  IFS=$'\t' read -r id _ by _ <<<"$line"
  R_RELEASE=1
  gate_open "$g" "$step" "goedgekeurd door ${by:-$approver}: release $R_VERSION${tag:+ (was $old)} (knop op het Dashboard)"
  command_done "$id" "done" "release $R_VERSION goedgekeurd"
}

human_gate_merge() { # gate: approval by merging on main with a higher version
  local g=$1
  local tag old before approver; tag=$(last_tag "$R_REPO"); old=${tag#v}
  before=$(cfg_list QualityGate "$g" spec/beforeSteps | paste -sd, -)
  if [ "$R_ENV" = werkplek ]; then
    # Reached the human gate: every automatic gate before it is open (a closed gate stops the run).
    # It waits for the approval only when a merge on main would release (a higher version).
    { [ -z "$tag" ] || ver_gt "$R_VERSION" "$old"; } && [ "$R_LIVE" = 1 ] || return 0
    approver=$(cfg QualityGate "$g" spec/approver "product owner")
    gate_started "$g" beforeSteps "$before" "$(printf '{"kind":"human","name":%s,"action":"merge op main met een hogere versie"}' "$(json_str "$approver")")"
    info "$g-gate wacht op $approver: merge op main met een hogere versie ($R_VERSION)"
    return 0
  fi
  if [ -z "$tag" ] || ver_gt "$R_VERSION" "$old"; then
    R_RELEASE=1
    gate_started "$g" beforeSteps "$before"
    emit "dev.cdeventsx.fcd-qualitygate.evaluated.0.1.0" "$g-gate" "$(printf '{"gate":%s,"afterSteps":"","outcome":"open","reason":%s,"explain":"","explainDetails":[]}' "$(json_str "$g")" "$(json_str "goedgekeurd door $(git -C "$R_REPO" log -1 --format=%an HEAD): merge op main met versie $R_VERSION${tag:+ (was $old)}")")"
    ok "${C_B}$g-gate open${C_0}: merge op main, versie $R_VERSION"
  else
    info "geen nieuwe versie ($R_VERSION = $tag): niet releasen"
  fi
}

# ---------------------------------------------------------------- bump

cmd_bump() {
  local repo="." what part
  [ $# -eq 3 ] && { repo=$1; shift; }
  what=${1:?container of subproduct}; part=${2:?major, minor of patch}
  repo=$(cd "$repo" && pwd)
  local var cur new
  if [ "$what" = subproduct ]; then var=SUBPRODUCT_VERSION; else var=$(container_var "$what"); fi
  cur=$(ver_get "$repo" "$var"); [ -n "$cur" ] || die "$var niet gevonden in versions.env"
  new=$(bump_ver "$cur" "$part")
  set_ver "$repo" "$var" "$new"; ok "$var $cur -> $new"
  if [ "$what" != subproduct ]; then
    # A new container version means a new sub-product version, once per change: compare with main,
    # because everything merged on main with a higher version is released by the Pipeline.
    local sp base; sp=$(ver_get "$repo" SUBPRODUCT_VERSION)
    git -C "$repo" fetch -q origin main 2>/dev/null || true
    base=$(ver_at_ref "$repo" origin/main SUBPRODUCT_VERSION)
    if [ -z "$base" ] || [ "$base" = "$sp" ]; then
      local nsp; nsp=$(bump_ver "$sp" "$part"); set_ver "$repo" SUBPRODUCT_VERSION "$nsp"; ok "SUBPRODUCT_VERSION $sp -> $nsp"
    fi
  fi
  local spv; spv=$(ver_get "$repo" SUBPRODUCT_VERSION)
  if [ -f "$repo/CHANGELOG.md" ] && [ -z "$(changelog_heading "$repo" "$spv")" ]; then
    awk -v h="## [$spv] - $(date +%Y-%m-%d)" '/^## \[Unreleased\]/ && !d {print; print ""; print h; d=1; next} {print}' "$repo/CHANGELOG.md" >"$repo/CHANGELOG.md.tmp"
    mv "$repo/CHANGELOG.md.tmp" "$repo/CHANGELOG.md"
    ok "CHANGELOG.md: kop $spv toegevoegd (zet de regels van [Unreleased] eronder)"
  fi
}
bump_ver() { local a b c; IFS=. read -r a b c <<<"$1"
  case $2 in major) echo "$((a+1)).0.0" ;; minor) echo "$a.$((b+1)).0" ;; patch) echo "$a.$b.$((c+1))" ;; *) die "major, minor of patch" ;; esac; }
set_ver() { sed -i.bak "s/^$2=.*/$2=$3/" "$1/versions.env" && rm -f "$1/versions.env.bak"; }

# ---------------------------------------------------------------- pinned versions of Pipeline and Dashboard

repo_url() { # where a repository comes from: FCD_REPO_BASE (a fork or a test), else the origin of the checkout next to the Pipeline
  if [ -n "${FCD_REPO_BASE:-}" ]; then printf '%s/%s.git' "$FCD_REPO_BASE" "$1"; return; fi
  git -C "$FCD_ROOT/$1" remote get-url origin 2>/dev/null || echo "$FCD_ORG_URL/$1.git"
}

pinned() { # repository version -> a checkout of that release (tag v<version>), shared by all showcases
  local repo=$1 ver=$2 src="$FCD_HOME/src/$1.git" dir="$FCD_HOME/versions/$1-$2"
  if [ -n "${FCD_DEV:-}" ]; then printf '%s' "$FCD_ROOT/$repo"; return; fi   # development: the checkout next to it
  [ -d "$dir" ] && { printf '%s' "$dir"; return; }
  mkdir -p "$FCD_HOME/src" "$FCD_HOME/versions"
  [ -d "$src" ] || git clone -q --bare "$(repo_url "$repo")" "$src"
  git -C "$src" fetch -q "$(repo_url "$repo")" '+refs/tags/*:refs/tags/*' 2>/dev/null || true
  git -C "$src" rev-parse -q --verify "refs/tags/v$ver" >/dev/null || die "$repo $ver bestaat nog niet (geen tag v$ver)"
  git -C "$src" worktree add -q --detach "$dir" "v$ver" >/dev/null
  printf '%s' "$dir"
}

pipeline_version() { cfg Pipeline "$(cfg_first Pipeline)" spec/uses/version; }
dashboard_version() { cfg Dashboard "$(cfg_first Dashboard)" spec/uses/version; }

dashboard_up() { # the Dashboard of the showcase: pinned version, own store, own port
  local dir; dir=$(pinned fcd-dashboard "$(dashboard_version)")
  local exp; exp=$(experiment_of)
  # The Dashboard reads the configuration of the showcase read-only (steps, gates, Dashboard.spec.live).
  DASHBOARD_DB_PASSWORD=$(fcd_secret dashboard-db) DEFAULT_EXPERIMENT="$exp" FCD_CONFIG_DIR="$SC_REPO/fcd" \
    docker compose -p "$SC_PREFIX-dashboard" --project-directory "$dir" --env-file "$dir/versions.env" \
    -f "$dir/docker-compose.yml" up -d --build --remove-orphans >"$SC_HOME/dashboard-up.log" 2>&1 \
    || { tail -20 "$SC_HOME/dashboard-up.log"; die "Dashboard start niet"; }
  ok "Dashboard $(dashboard_version) (showcase $SC_NAME): http://127.0.0.1:$PORT_DASHBOARD"
}

registry_start() { # the API-register of the showcase (Apicurio Registry, tool of FCD)
  [ -n "${PORT_REGISTRY:-}" ] || { info "geen poort voor het API-register in de configuratie"; return 0; }
  [ -n "${PORT_REGISTRY_UI:-}" ] || export PORT_REGISTRY_UI=$((PORT_REGISTRY + 1))
  TOOL_APICURIO="$TOOL_APICURIO" TOOL_APICURIO_UI="$TOOL_APICURIO_UI" \
    docker compose -p "$SC_PREFIX-registry" -f "$FCD_PIPELINE_DIR/tools/registry.compose.yml" up -d >"$SC_HOME/registry-up.log" 2>&1 \
    || { tail -5 "$SC_HOME/registry-up.log"; die "API-register start niet"; }
  local i; for i in $(seq 1 60); do registry_up_ok && break; sleep 2; done
  registry_up_ok && ok "API-register (Apicurio Registry, in het geheugen): http://127.0.0.1:$PORT_REGISTRY_UI (API op $PORT_REGISTRY)" || { bad "API-register reageert niet"; return 0; }
  registry_seed
}

registry_seed() { # fill the register from git: every contract of the configuration, as in its released version
  local c repo file type ref src tmp ver r n=0
  for c in $(cfg_names Contract); do
    repo=$(cfg Contract "$c" spec/repository); file=$(cfg Contract "$c" spec/file); type=$(cfg Contract "$c" spec/type OPENAPI)
    case "$repo" in
      fcd-dashboard) src=$(pinned fcd-dashboard "$(dashboard_version)"); ref=HEAD ;;
      fcd-pipeline)  src=$(pinned fcd-pipeline "$(pipeline_version)"); ref=HEAD ;;
      *) src="$FCD_ROOT/$repo"; git -C "$src" fetch -q --tags origin 2>/dev/null || true; ref=$(last_tag "$src") ;;
    esac
    [ -n "$ref" ] && [ -d "$src" ] || continue
    tmp=$(mktemp -d)
    git -C "$src" archive "$ref" 2>/dev/null | tar -x -C "$tmp" 2>/dev/null || { rm -rf "$tmp"; continue; }
    if [ -f "$tmp/$file" ]; then
      ver=$(contract_version "$tmp" "$file" "$type")
      if [ -z "$ver" ]; then info "  contract $c in $repo $ref heeft nog geen versie: niet geregistreerd"
      elif ! registry_has "$c" "$ver"; then
        r=$(registry_add "$c" "$ver" "$tmp" "$file" "$type")
        case "${r%% *}" in 200) n=$((n + 1)) ;; *) bad "  contract $c $ver niet geregistreerd (${r%% *}: $(printf '%s' "$r" | sed -n 's/.*"title":"\([^"]*\)".*/\1/p'))" ;; esac
      fi
    fi
    rm -rf "$tmp"
    # Title and labels from the configuration, also for contracts that were already there.
    [ "$(registry_call GET "/artifacts/$c" | cut -d' ' -f1)" = 200 ] && registry_set_meta "$c"
  done
  # The group is the showcase (it exists once a contract is registered).
  registry_call PUT "" "$(printf '{"description":%s,"labels":{"showcase":%s}}' "$(json_str "Contracten van showcase $SC_NAME (configuratie: $(basename "$SC_REPO")/fcd)")" "$(json_str "$SC_NAME")")" >/dev/null
  ok "API-register gevuld uit git ($n nieuwe contractversies)"
}

# ---------------------------------------------------------------- agent (the Pipeline)

agent_repos() { # the product repositories of the showcase (configuration), or for D1 FCD's own repositories
  if [ -n "${FCD_SHOWCASE_OVERRIDE:-}" ]; then printf '%s\n' fcd-pipeline fcd-dashboard; return; fi
  local s; for s in $(cfg_names SubProduct); do cfg SubProduct "$s" spec/repository; done | sort -u
}

agent_once() { # showcase repository
  local sc_src=$1 r work state head last cfgwork
  mkdir -p "$SC_HOME/work" "$SC_HOME/state"
  # GitOps: the configuration that counts is the one on main of the showcase repository.
  local sc_name; sc_name=$(basename "$sc_src")
  cfgwork="$SC_HOME/work/$sc_name"
  local sc_url; sc_url=$(repo_url "$sc_name")
  [ -d "$cfgwork/.git" ] || git clone -q "$sc_url" "$cfgwork"
  git -C "$cfgwork" remote set-url origin "$sc_url"
  git -C "$cfgwork" fetch -q origin main 2>/dev/null || true
  head=$(git -C "$cfgwork" rev-parse origin/main 2>/dev/null || echo none)
  if [ "$head" != "$(cat "$SC_HOME/state/config.last" 2>/dev/null || true)" ]; then
    git -C "$cfgwork" checkout -q --detach "$head" 2>/dev/null || true
    if [ -s "$SC_HOME/state/config.last" ]; then
      # A change in the configuration (such as a threshold): run every repository of the showcase again.
      say "$(now_iso) configuratie $sc_name gewijzigd ($head): alles opnieuw door de pipeline"
      rm -f "$SC_HOME"/state/repo-*.last
      export FCD_CONFIG_CHANGED=1
    fi
    echo "$head" >"$SC_HOME/state/config.last"
  fi
  showcase_load "$cfgwork" "$SC_HOME/config.props"
  local runner; runner="$(pinned fcd-pipeline "$(pipeline_version)")/fcd"
  for r in $(agent_repos); do
    work="$SC_HOME/work/$r"; state="$SC_HOME/state/repo-$r.last"
    if [ ! -d "$work/.git" ]; then git clone -q "$(repo_url "$r")" "$work" || { info "$r: clone mislukt"; continue; }; fi
    git -C "$work" remote set-url origin "$(repo_url "$r")"
    # Only what is on main: what the product owner merged. Never code from a pull request.
    git -C "$work" fetch -q --prune --tags origin main 2>/dev/null || { info "$r: fetch mislukt"; continue; }
    head=$(git -C "$work" rev-parse origin/main)
    last=$(cat "$state" 2>/dev/null || true)
    [ "$head" = "$last" ] && continue
    AGENT_RAN=$((AGENT_RAN + 1))
    say "$(now_iso) $r: nieuw op main $head (Pipeline $(pipeline_version))"
    git -C "$work" checkout -q --detach "$head" && git -C "$work" clean -qfdx -e .fcd
    if FCD_SHOWCASE_DIR="$cfgwork" "$runner" ci "$work" --env lokaal; then say "$(now_iso) $r: gelukt"; AGENT_RESULT="${AGENT_RESULT:+$AGENT_RESULT; }$r: gelukt"
    else say "$(now_iso) $r: gestopt (gate dicht of fout)"; AGENT_RESULT="${AGENT_RESULT:+$AGENT_RESULT; }$r: gestopt"; AGENT_FAILED=1; fi
    echo "$head" >"$state"
  done
}

cmd_agent() {
  local sc="" once=0
  while [ $# -gt 0 ]; do case $1 in --showcase) sc=$2; shift 2 ;; --once) once=1; shift ;; *) die "fcd agent --showcase dir [--once]" ;; esac; done
  sc=$(cd "$(showcase_dir_arg "$sc")" && pwd)
  showcase_load "$sc" "$(mktemp)"
  [ "$once" = 1 ] && { agent_once "$sc"; return; }
  if [ "$(cfg Pipeline "$(cfg_first Pipeline)" spec/trigger merge-on-main)" = dashboard-button ]; then
    # The human gate at the start: the agent runs only when the product owner presses the button on the Dashboard.
    say "$(now_iso) Pipeline-agent gestart: showcase $SC_NAME (wacht op de knop op het Dashboard; bron: $(repo_url "$(basename "$sc")"))"
    while true; do agent_command "$sc" || true; flush_outbox >/dev/null 2>&1 || true; sleep "$FCD_COMMAND_INTERVAL"; done
  fi
  say "$(now_iso) Pipeline-agent gestart: showcase $SC_NAME (elke ${FCD_AGENT_INTERVAL}s)"
  while true; do agent_once "$sc" || true; flush_outbox >/dev/null 2>&1 || true; sleep "$FCD_AGENT_INTERVAL"; done
}

agent_command() { # showcase repository: carry out one command of the Dashboard (start a run, reset the demo)
  local line id kind by save
  line=$(command_claim start-run,demo-reset)
  [ -n "$line" ] || return 0
  IFS=$'\t' read -r id kind by save _ <<<"$line"
  by=${by:-$(cfg QualityGate human spec/approver "product owner")}
  case $kind in
    start-run)
      say "$(now_iso) start door $by (knop op het Dashboard)"
      AGENT_RAN=0; AGENT_RESULT=""; AGENT_FAILED=0
      export FCD_TRIGGER_KIND=human FCD_TRIGGER_NAME="$by"
      agent_once "$1" || AGENT_FAILED=1
      unset FCD_TRIGGER_KIND FCD_TRIGGER_NAME
      if [ "$AGENT_RAN" = 0 ]; then command_done "$id" "done" "niets nieuws op main: geen run"
      elif [ "$AGENT_FAILED" = 1 ]; then command_done "$id" failed "$AGENT_RESULT"
      else command_done "$id" "done" "$AGENT_RESULT"; fi ;;
    demo-reset)
      say "$(now_iso) Demo opnieuw door $by (knop op het Dashboard)"
      local opt=""; [ "$save" = true ] && opt=--save
      if "$FCD_SELF" demo reset --showcase "$1" --by "$by" $opt >>"$SC_HOME/agent.log" 2>&1; then command_done "$id" "done" "demo teruggezet"
      else command_done "$id" failed "reset mislukt, zie fcd logs"; fi ;;
    *) command_done "$id" rejected "onbekend commando: $kind" ;;
  esac
}

showcase_projects() { # the exact compose projects of the showcase (never a prefix match: other projects may share it)
  printf '%s\n' "$SC_PREFIX-dashboard" "$SC_PREFIX-registry"
  local sp; for sp in $(cfg_names SubProduct); do printf '%s\n' "$SC_PREFIX-$sp"; done
}
project_exists() { docker compose -p "$1" ps -a -q 2>/dev/null | grep -q .; }

agent_running() { [ -f "$SC_HOME/agent.pid" ] && kill -0 "$(cat "$SC_HOME/agent.pid")" 2>/dev/null; }

cmd_up() { # one command per showcase: its Dashboard and its Pipeline agent, with its configuration and versions
  local sc=""; [ "${1:-}" = --showcase ] && sc=$2
  sc=$(cd "$(showcase_dir_arg "$sc")" && pwd)
  showcase_load "$sc" "$(mktemp)"
  say "${C_B}fcd up${C_0} showcase $SC_NAME: Pipeline $(pipeline_version), Dashboard $(dashboard_version)"
  dashboard_up
  registry_start
  local p; for p in $(showcase_projects | grep -vx "$SC_PREFIX-dashboard" | grep -vx "$SC_PREFIX-registry"); do
    project_exists "$p" && docker compose -p "$p" start >/dev/null 2>&1 && ok "$p gestart"
  done
  if agent_running; then ok "Pipeline-agent draait al"
  else
    local runner; runner="$(pinned fcd-pipeline "$(pipeline_version)")/fcd"
    nohup "$runner" agent --showcase "$SC_REPO" >>"$SC_HOME/agent.log" 2>&1 &
    echo $! >"$SC_HOME/agent.pid"; ok "Pipeline-agent $(pipeline_version) gestart (log: fcd logs)"
  fi
  info "Eerste keer? De agent bouwt en rolt alles uit vanaf main; dat duurt even. Volg het met: fcd logs"
  local k env; env=$(cfg_first Environment)
  for k in $(cfg_keys Environment "$env" spec/ports); do say "  $k: http://127.0.0.1:$(cfg Environment "$env" "spec/ports/$k")"; done
}

cmd_down() {
  local sc=""; [ "${1:-}" = --showcase ] && sc=$2
  showcase_load "$(cd "$(showcase_dir_arg "$sc")" && pwd)" "$(mktemp)"
  if [ -f "$SC_HOME/agent.pid" ]; then kill "$(cat "$SC_HOME/agent.pid")" 2>/dev/null || true; rm -f "$SC_HOME/agent.pid"; ok "Pipeline-agent gestopt"; fi
  local p; for p in $(showcase_projects); do
    project_exists "$p" && docker compose -p "$p" stop >/dev/null 2>&1 && ok "$p gestopt"
  done
}

cmd_status() {
  local sc=""; [ "${1:-}" = --showcase ] && sc=$2
  showcase_load "$(cd "$(showcase_dir_arg "$sc")" && pwd)" "$(mktemp)"
  if agent_running; then ok "Pipeline-agent draait (showcase $SC_NAME)"; else bad "Pipeline-agent draait niet (fcd up)"; fi
  local p; for p in $(showcase_projects); do
    docker ps --filter "label=com.docker.compose.project=$p" --format '{{.Label "com.docker.compose.project"}}\t{{.Names}}\t{{.Image}}\t{{.Status}}'
  done
}

cmd_logs() {
  local sc=""; [ "${1:-}" = --showcase ] && sc=$2
  showcase_load "$(cd "$(showcase_dir_arg "$sc")" && pwd)" "$(mktemp)"
  tail -n 50 -f "$SC_HOME/agent.log"
}

cmd_report() { # the status report and the log of the experiment, in the showcase repository (to keep, share and compare)
  local sc=""; [ "${1:-}" = --showcase ] && sc=$2
  showcase_load "$(cd "$(showcase_dir_arg "$sc")" && pwd)" "$(mktemp)"
  local base="${FCD_DASHBOARD_URL%/api/v1/events}" exp file
  exp=$(curl -fsS -m 10 "$base/api/v1/overview" | sed -n 's/.*"experiment":"\([^"]*\)".*/\1/p' | head -1)
  [ -n "$exp" ] || die "Dashboard van $SC_NAME niet bereikbaar op $base"
  mkdir -p "$SC_REPO/reports" "$SC_REPO/log"
  file="$SC_REPO/reports/$(date -u +%Y-%m-%d-%H%M)-$SC_NAME-$exp.md"
  curl -fsS -m 10 "$base/api/v1/report?experiment=$exp" >"$file"
  ok "statusrapport: $file"
  curl -fsS -m 30 "$base/api/v1/events?experiment=$exp" >"$SC_REPO/log/$exp.jsonl"
  ok "log: $SC_REPO/log/$exp.jsonl ($(wc -l <"$SC_REPO/log/$exp.jsonl" | tr -d ' ') logregels)"
}

cmd_experiment() { # experiment [start <name>]: every experiment starts with an empty log
  local action="" name="" sc=""
  while [ $# -gt 0 ]; do case $1 in start) action=start; name=${2:-}; shift 2 || shift ;; --showcase) sc=$2; shift 2 ;; *) die "fcd experiment [start <naam>] [--showcase dir]" ;; esac; done
  showcase_load "$(cd "$(showcase_dir_arg "$sc")" && pwd)" "$(mktemp)"
  local cur; cur=$(experiment_of)
  if [ "$action" != start ]; then say "$cur"; return; fi
  printf '%s' "$name" | grep -Eq '^[A-Za-z0-9._-]{1,50}$' || die "naam: alleen letters, cijfers, . _ - (max 50)"
  printf '%s\n' "$name" >"$SC_HOME/experiment"
  # Run every repository again, so the deployed containers measure in the new experiment too.
  rm -f "$SC_HOME"/state/repo-*.last
  ok "experiment $name gestart in showcase $SC_NAME (was $cur). De log van $cur blijft bewaard en is te kiezen in het Dashboard."
  info "De agent haalt alles opnieuw door de pipeline; daarna meten de containers in $name."
}

# ---------------------------------------------------------------- demo (repeatable, everything local)

demo_cfg() { cfg Pipeline "$(cfg_first Pipeline)" "spec/demo/$1" "${2:-}"; }
demo_repos() { # the repositories of the demo: the showcase, its product repositories, and the Pipeline and Dashboard (pinned)
  { basename "$SC_REPO"; agent_repos; printf '%s\n' fcd-pipeline fcd-dashboard; } | awk '!seen[$0]++'
}
demo_require_local() {
  [ "$(cfg Pipeline "$(cfg_first Pipeline)" spec/source origin)" = local-git ] \
    || die "de demo werkt alleen met een lokale bron (Pipeline.spec.source: local-git in de configuratie)"
}

demo_seed() { # fill the local git server from the checkouts next to the Pipeline; keep the start as refs/demo-seed
  local r co bare start b pat
  mkdir -p "$FCD_HOME/git"
  for r in $(demo_repos); do
    co="$FCD_ROOT/$r"; bare="$FCD_HOME/git/$r.git"
    [ -d "$co/.git" ] || die "$r: geen checkout in $FCD_ROOT"
    [ -d "$bare" ] || git init -q --bare -b main "$bare"
    git -C "$bare" for-each-ref --format='%(refname)' refs/heads refs/tags refs/demo-seed | while read -r b; do git -C "$bare" update-ref -d "$b"; done
    start=$(demo_cfg startTag demo-start)
    if git -C "$co" rev-parse -q --verify "refs/tags/$start" >/dev/null; then
      git -C "$co" push -q "$bare" "refs/tags/$start^{commit}:refs/heads/main" "refs/tags/$start:refs/tags/$start"
    else
      git -C "$co" push -q "$bare" "HEAD:refs/heads/main"
    fi
    git -C "$co" push -q "$bare" 'refs/tags/v*:refs/tags/v*' 2>/dev/null || true
    # The prepared changes (configuration: Pipeline.spec.demo.branches), such as the patch: local branches only.
    for pat in $(demo_cfg branches | tr -d '[],"'); do
      git -C "$co" for-each-ref --format='%(refname:short)' "refs/heads/$pat" | while read -r b; do
        git -C "$co" push -q "$bare" "refs/heads/$b:refs/heads/$b"
      done
    done
    git -C "$bare" for-each-ref --format='%(refname) %(objectname)' refs/heads refs/tags | while read -r b o; do
      git -C "$bare" update-ref "refs/demo-seed/${b#refs/}" "$o"
    done
    ok "$r: lokale git-server $bare (main = ${start} of HEAD)"
  done
}

demo_restore() { # every bare repository back to its seed: main to the start, the patch branch back, newer tags gone
  local r bare b o
  for r in $(demo_repos); do
    bare="$FCD_HOME/git/$r.git"
    git -C "$bare" for-each-ref --format='%(refname)' refs/heads refs/tags | while read -r b; do
      git -C "$bare" rev-parse -q --verify "refs/demo-seed/${b#refs/}" >/dev/null || git -C "$bare" update-ref -d "$b"
    done
    git -C "$bare" for-each-ref --format='%(refname) %(objectname)' refs/demo-seed | while read -r b o; do
      git -C "$bare" update-ref "refs/${b#refs/demo-seed/}" "$o"
    done
  done
}

demo_deploy() { # repo: deploy what is on main of the local git server (the start), so the demo begins from there
  local r=$1 work="$SC_HOME/work/$1"
  [ -d "$work/.git" ] || git clone -q "$(repo_url "$r")" "$work"
  git -C "$work" remote set-url origin "$(repo_url "$r")"
  git -C "$work" fetch -q --prune --prune-tags --tags origin main
  git -C "$work" checkout -q --detach origin/main && git -C "$work" clean -qfdx -e .fcd
  git -C "$work" tag -l | while read -r t; do git -C "$work" ls-remote --exit-code --tags origin "refs/tags/$t" >/dev/null || git -C "$work" tag -d "$t" >/dev/null; done
  git -C "$work" rev-parse origin/main >"$SC_HOME/state/repo-$r.last"
  (
    FCD_TRIGGER_KIND=human FCD_TRIGGER_NAME=$DEMO_BY start_run "$work" lokaal "$SC_REPO"
    [ -n "${CI_COMPOSE_FILES:-}" ] || exit 0
    compose_r "$R_PROJECT" up -d --build --remove-orphans >"$SC_HOME/demo-deploy-$r.log" 2>&1 || { tail -20 "$SC_HOME/demo-deploy-$r.log"; exit 1; }
    wait_ready "$R_PROJECT" || { bad "$R_SUBPRODUCT niet bereikbaar"; exit 1; }
    # Not a pipeline run (run is empty): the start of the demo, with its changelog for the Dashboard.
    R_ID=""; R_DEPLOYED=1; emit_deployed
    ok "$R_SUBPRODUCT $R_VERSION uitgerold (experiment $R_EXPERIMENT)"
  )
}

demo_logline() { # the reset as a log line in the new, empty log (contract 0.5.0; run is empty: not a pipeline run)
  local by=$1 exp=$2 saved=$3 product
  ver_ge "$(dashboard_version)" "$V05_SINCE_DASHBOARD" || return 0
  product="$SC_HOME/work/$(agent_repos | head -1)"
  R_NAME=$(basename "$SC_REPO"); R_DIR="$SC_HOME"; R_REPO="$product"; R_ID=""
  R_SHA=$(git -C "$product" rev-parse --short HEAD 2>/dev/null || echo none); R_COMMIT_TIME=$(now_iso)
  R_TRIGGER_KIND=human; R_TRIGGER_NAME=$by; R_CONTAINERS=""
  R_PRODUCT=$(ver_get "$product" PRODUCT); R_SUBPRODUCT=$(ver_get "$product" SUBPRODUCT); R_VERSION=$(ver_get "$product" SUBPRODUCT_VERSION)
  R_EXPERIMENT=$exp; R_ENV=lokaal; R_RELEASE_TYPE=planned
  emit "dev.cdeventsx.fcd-demo.reset.0.1.0" "$SC_NAME" "$(printf '{"startTag":%s,"saved":%s}' "$(json_str "$(demo_cfg startTag demo-start)")" "$saved")"
}

cmd_demo() { # demo reset [--save] [--by name] | seed | diff [branch] | merge <branch> [--by name]   (--showcase dir)
  local action=${1:-}; shift || true
  local sc="" save=0 by="" branch=""
  while [ $# -gt 0 ]; do
    case $1 in
      --showcase) sc=$2; shift 2 ;;
      --save) save=1; shift ;;
      --by) by=$2; shift 2 ;;
      -*) die "onbekende optie $1" ;;
      *) branch=$1; shift ;;
    esac
  done
  showcase_load "$(cd "$(showcase_dir_arg "$sc")" && pwd)" "$(mktemp)"
  demo_require_local
  by=${by:-$(cfg QualityGate human spec/approver "product owner")}
  local product; product=$(agent_repos | head -1)
  [ -n "$branch" ] || branch=$(git -C "$FCD_HOME/git/$product.git" for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null | grep -vx main | head -1)
  case $action in
    seed) demo_seed ;;
    reset)
      say "${C_B}fcd demo reset${C_0} showcase $SC_NAME (door $by)"
      # 1. keep the run and the status report, when asked
      if [ "$save" = 1 ]; then cmd_report --showcase "$SC_REPO" || bad "statusrapport niet bewaard"; fi
      # 2. the local git server back to the start (the first time: fill it from the checkouts)
      if [ ! -d "$FCD_HOME/git/$product.git" ]; then demo_seed; else demo_restore; ok "lokale git terug naar $(demo_cfg startTag demo-start)"; fi
      # 4. an empty log: a new experiment (the old log stays in the store)
      local exp; exp="demo-$(date +%Y%m%d-%H%M%S)"
      printf '%s\n' "$exp" >"$SC_HOME/experiment"
      ok "lege log: experiment $exp"
      # 3. the start deployed again, measuring in the new experiment
      export DEMO_BY=$by
      local r; for r in $(agent_repos); do demo_deploy "$r"; done
      git -C "$SC_HOME/work/$(basename "$SC_REPO")" fetch -q origin main 2>/dev/null && \
        git -C "$SC_HOME/work/$(basename "$SC_REPO")" rev-parse origin/main >"$SC_HOME/state/config.last" 2>/dev/null || true
      demo_logline "$by" "$exp" "$([ "$save" = 1 ] && echo true || echo false)"
      ok "demo staat klaar: $(agent_repos | tr '\n' ' ')op $(demo_cfg startTag demo-start)" ;;
    diff)
      local tmp; tmp=$(mktemp -d)
      git clone -q "$FCD_HOME/git/$product.git" "$tmp/$product"
      git -C "$tmp/$product" log --format='%h %s (%an)' "main..origin/$branch"
      git -C "$tmp/$product" diff --stat "main...origin/$branch"
      git -C "$tmp/$product" -c color.ui=always diff "main...origin/$branch" -- . ':(exclude)*.lock' ':(exclude)package-lock.json'
      rm -rf "$tmp" ;;
    merge)
      local tmp email; tmp=$(mktemp -d); email=$(git config user.email || echo "product-owner@localhost")
      git clone -q "$FCD_HOME/git/$product.git" "$tmp/$product"
      git -C "$tmp/$product" -c user.name="$by" -c user.email="$email" merge -q --no-ff "origin/$branch" \
        -m "Merge $branch: $(git -C "$tmp/$product" log -1 --format=%s "origin/$branch")" -m "Pull request $branch, goedgekeurd door $by."
      git -C "$tmp/$product" push -q origin main
      ok "$branch gemerged op main van $product (lokaal, door $by). Start de pipeline met de knop op het Dashboard."
      rm -rf "$tmp" ;;
    *) die "fcd demo reset [--save] [--by naam] | seed | diff [branch] | merge [branch] [--by naam]" ;;
  esac
}

cmd_hooks() { # install the pre-push hook: the same CI steps and gates before every push
  local repo; repo=$(cd "${1:-.}" && pwd)
  cat >"$repo/.git/hooks/pre-push" <<EOF
#!/usr/bin/env bash
# Installed by 'fcd hooks': same CI steps and gates as the Pipeline, before every push.
exec "$FCD_SELF" ci "$repo" --env werkplek
EOF
  chmod +x "$repo/.git/hooks/pre-push"; ok "pre-push-hook in $repo"
}

case "${1:-}" in
  check)      shift; cmd_check "$@" ;;
  hooks)      shift; cmd_hooks "$@" ;;
  report)     shift; cmd_report "$@" ;;
  experiment) shift; cmd_experiment "$@" ;;
  ci)         shift; cmd_ci "$@" ;;
  bump)       shift; cmd_bump "$@" ;;
  agent)      shift; cmd_agent "$@" ;;
  up)         shift; cmd_up "$@" ;;
  down)       shift; cmd_down "$@" ;;
  status)     shift; cmd_status "$@" ;;
  logs)       shift; cmd_logs "$@" ;;
  demo)       shift; cmd_demo "$@" ;;
  version)    echo "fcd $FCD_VERSION" ;;
  *) sed -n '2,22p' "$FCD_SELF" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
